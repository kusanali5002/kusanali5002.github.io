---
import BaseLayout from '../layouts/BaseLayout.astro';

const contactChannels = [
  {
    name: 'TikTok',
    handle: '@kusanali.workstation',
    desc: 'Short - form motion graphics, gaming highlights, and experimental video cuts.',
    url: 'https://www.tiktok.com/@kusanali.workstation',
    icon: '⚡',
    badge: 'Video & Motion',
  },
  {
    name: 'YouTube',
    handle: 'Kusanali Workstation',
    desc: 'Longer breakdown guides, Genshin / HSR livestreams and editing.',
    url: 'https://www.youtube.com/@kusanali.workstation',
    icon: '▶',
    badge: 'Livestream ganme & editing',
  },
  {
    name: 'Facebook',
    handle: 'Ha Manh Dung (The Kusanali)',
    desc: 'Personal updates and community conversations.',
    url: 'https://www.facebook.com/kusanali.workstation',
    icon: '❖',
    badge: 'Social & Community',
  },

];
---

<BaseLayout
  title="Contact - Connect with Dun"
  description="Connect with Ha Manh Dung across TikTok, YouTube, Facebook, and GitHub for collaborations and discussions."
  section="contact"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-mono uppercase tracking-widest bg-sumeru-100 dark:bg-nahida-mint/10 text-sumeru-800 dark:text-nahida-mint border border-sumeru-300/40 dark:border-nahida-mint/20 mb-4">
        <span>TRANSMISSION & INQUIRY</span>
      </div>
      <h1 class="font-display font-bold text-3xl sm:text-5xl text-sumeru-950 dark:text-white tracking-tight mb-4">
        Get In Touch
      </h1>
      <p class="text-base sm:text-lg text-sumeru-800/80 dark:text-nahida-light/80">
        Whether you want to discuss motion graphics, collaborate on game UI, or simply say hello - my channels are open.
      </p>
    </div>

    <!-- Contact Cards Grid -->
    <div class="contact-grid grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      {contactChannels.map((item) => (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group reveal-on-scroll p-6 rounded-3xl glass-panel border border-sumeru-200/60 dark:border-white/[0.08] hover:border-sumeru-400 dark:hover:border-nahida-mint/40 transition-all flex flex-col justify-between w-full"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="w-10 h-10 rounded-2xl bg-sumeru-100 dark:bg-sumeru-900/60 flex items-center justify-center text-lg text-sumeru-900 dark:text-nahida-mint border border-sumeru-200/50 dark:border-nahida-mint/20">
                {item.icon}
              </span>
              <span class="text-[11px] font-mono px-2.5 py-1 rounded-full bg-sumeru-50 dark:bg-sumeru-950/70 text-sumeru-700 dark:text-nahida-mint/80 border border-sumeru-200/40 dark:border-nahida-mint/20">
                {item.badge}
              </span>
            </div>

            <h3 class="font-display font-bold text-xl text-sumeru-950 dark:text-white group-hover:text-sumeru-600 dark:group-hover:text-nahida-mint transition-colors mb-1">
              {item.name}
            </h3>
            <div class="text-xs font-mono text-sumeru-600 dark:text-nahida-mint/80 mb-3">
              {item.handle}
            </div>
            <p class="text-xs sm:text-sm text-sumeru-800/80 dark:text-nahida-light/75 leading-relaxed">
              {item.desc}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-sumeru-200/40 dark:border-white/[0.05] flex items-center justify-between text-xs font-semibold text-sumeru-700 dark:text-nahida-mint">
            <span>Connect on {item.name}</span>
            <span class="transform group-hover:translate-x-1 group-hover:-translate-y-0.5 transition-transform">↗</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Direct Note & Email Box -->
    <div class="glass-panel rounded-3xl p-8 border border-sumeru-200/60 dark:border-white/[0.08] text-center max-w-xl mx-auto">
      <h3 class="font-display font-bold text-lg text-sumeru-950 dark:text-white mb-2">
        Direct Email Contact
      </h3>
      <p class="text-xs sm:text-sm text-sumeru-800/80 dark:text-nahida-light/80 mb-4 leading-relaxed">
        For inquiries regarding video commissions, development collaborations, or private feedback:
      </p>
      <a
        href="mailto:manhdungha023@gmail.com"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-sumeru-600 dark:bg-nahida-mint text-white dark:text-sumeru-950 text-xs font-mono font-semibold hover:bg-sumeru-700 dark:hover:bg-white transition-all shadow-md"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span>manhdungha023@gmail.com</span>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  /* Center the last card when it's alone on a row (odd total in a 2-col grid) */
  @media (min-width: 768px) {
    .contact-grid > a:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      max-width: calc(50% - 12px);
      margin-inline: auto;
    }
  }
</style>
