---

<BaseLayout
  title="Nahida - Lesser Lord Kusanali"
  description="Nahida character dossier: gameplay information, stats, ascension materials, talents, and constellations."
  section="nahida"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    
    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-mono uppercase tracking-widest bg-emerald-500/10 dark:bg-nahida-mint/10 text-emerald-800 dark:text-nahida-mint border border-emerald-500/20 dark:border-nahida-mint/30 mb-3">
        <span>ARCHON OF DENDRO • LESSER LORD KUSANALI</span>
      </div>
      <h1 class="font-display font-bold text-3xl sm:text-5xl md:text-6xl text-sumeru-950 dark:text-white tracking-tight mb-3">
        Nahida
      </h1>
      <p class="text-xs font-mono text-sumeru-600 dark:text-nahida-mint/80">
        #specialcharacter #genshinimpact | Post day : June 26th 2025
      </p>
    </div>

    <!-- Thematic Narrative Section: Exact Original Text & Visuals -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center mb-20">
      <div class="md:col-span-5 flex justify-center">
        <div class="relative w-64 h-64 sm:w-80 sm:h-80 rounded-3xl overflow-hidden glass-panel border-2 border-sumeru-300/60 dark:border-nahida-mint/30 shadow-2xl group">
          <img
            src="/images/nahida.jpg"
            alt="Nahida, Lesser Lord Kusanali"
            class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <div class="absolute bottom-4 left-4 right-4 text-center">
            <span class="text-xs font-mono text-white/90 drop-shadow-md">
              Sanctuary of Surasthana
            </span>
          </div>
        </div>
      </div>

      <div class="md:col-span-7 space-y-6">
        <div class="space-y-4">
          <h2 class="font-display font-bold text-2xl sm:text-3xl text-sumeru-950 dark:text-white">
            Nahida
          </h2>
          <p class="text-base text-sumeru-800/90 dark:text-nahida-light/90 leading-relaxed">
            Nahida is a playable Dendro character in Genshin Impact (and is my lover ehe).
          </p>
          <p class="text-base text-sumeru-800/90 dark:text-nahida-light/90 leading-relaxed">
            As Lesser Lord Kusanali, she strives to have a stronger presence in Sumeru now that she has been freed from her extensive confinement in the Sanctuary of Surasthana.
          </p>
        </div>

        <div class="grid grid-cols-3 gap-3 pt-4 border-t border-sumeru-200/40 dark:border-white/[0.08]">
          <div class="p-3.5 rounded-2xl glass-panel text-center">
            <div class="text-[11px] font-mono text-sumeru-600 dark:text-nahida-mint mb-0.5">ELEMENT</div>
            <div class="font-display font-bold text-sm sm:text-base text-sumeru-950 dark:text-white">Dendro</div>
          </div>
          <div class="p-3.5 rounded-2xl glass-panel text-center">
            <div class="text-[11px] font-mono text-sumeru-600 dark:text-nahida-mint mb-0.5">ROLE</div>
            <div class="font-display font-bold text-xs sm:text-sm md:text-base leading-tight text-sumeru-950 dark:text-white">Support / Sub DPS</div>
          </div>
          <div class="p-3.5 rounded-2xl glass-panel text-center">
            <div class="text-[11px] font-mono text-sumeru-600 dark:text-nahida-mint mb-0.5">WEAPON</div>
            <div class="font-display font-bold text-sm sm:text-base text-sumeru-950 dark:text-white">Catalyst</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Section Navigation Chips -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-16">
      <a href="#section-talents" class="px-4 py-2 rounded-full text-xs font-mono bg-sumeru-100 dark:bg-white/5 border border-sumeru-200/60 dark:border-white/10 hover:border-sumeru-400 dark:hover:border-nahida-mint text-sumeru-800 dark:text-nahida-light transition-all">
        Talents
      </a>
      <a href="#section-constellations" class="px-4 py-2 rounded-full text-xs font-mono bg-sumeru-100 dark:bg-white/5 border border-sumeru-200/60 dark:border-white/10 hover:border-amber-400 dark:hover:border-nahida-gold text-sumeru-800 dark:text-nahida-light transition-all">
        Constellations
      </a>
      <a href="#section-ascensions" class="px-4 py-2 rounded-full text-xs font-mono bg-sumeru-100 dark:bg-white/5 border border-sumeru-200/60 dark:border-white/10 hover:border-sumeru-400 dark:hover:border-nahida-mint text-sumeru-800 dark:text-nahida-light transition-all">
        Ascensions & Stats Table
      </a>
      <a href="#section-talent-costs" class="px-4 py-2 rounded-full text-xs font-mono bg-sumeru-100 dark:bg-white/5 border border-sumeru-200/60 dark:border-white/10 hover:border-sumeru-400 dark:hover:border-nahida-mint text-sumeru-800 dark:text-nahida-light transition-all">
        Talent Upgrade Table
      </a>
      <a href="#section-availability" class="px-4 py-2 rounded-full text-xs font-mono bg-sumeru-100 dark:bg-white/5 border border-sumeru-200/60 dark:border-white/10 hover:border-sumeru-400 dark:hover:border-nahida-mint text-sumeru-800 dark:text-nahida-light transition-all">
        Event Wishes
      </a>
      <a href="#section-languages" class="px-4 py-2 rounded-full text-xs font-mono bg-sumeru-100 dark:bg-white/5 border border-sumeru-200/60 dark:border-white/10 hover:border-sumeru-400 dark:hover:border-nahida-mint text-sumeru-800 dark:text-nahida-light transition-all">
        Languages
      </a>
    </div>

    <!-- 1. Talents Section -->
    <div id="section-talents" class="mb-20 scroll-mt-24">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-mono uppercase tracking-widest text-sumeru-600 dark:text-nahida-mint mb-2 block">
          Gameplay Information
        </span>
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-sumeru-950 dark:text-white">
          Talents
        </h2>
      </div>

