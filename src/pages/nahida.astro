                </div>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-amber-500/10 dark:bg-amber-400/10 text-amber-900 dark:text-amber-300 font-mono text-[11px] font-semibold">
                  <img src="/images/mora.webp" alt="Mora" class="w-3.5 h-3.5 object-contain" />
                  <span>{row.mora}</span>
                </span>
              </div>

              <!-- Required Materials Chips (Wrapped for 100% Mobile Screen Width) -->
              <div class="flex flex-wrap gap-1.5 items-center">
                <!-- Common Material -->
                <span class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-sumeru-100/80 dark:bg-white/5 text-sumeru-900 dark:text-nahida-light font-mono text-[11px] border border-sumeru-200/60 dark:border-white/10">
                  <img src={row.common.icon} alt={row.common.name} class="w-3.5 h-3.5 object-contain" />
                  <span>{row.common.count}x {row.common.name}</span>
                </span>

                <!-- Talent Book -->
                <span class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-emerald-500/10 dark:bg-nahida-mint/10 text-emerald-900 dark:text-nahida-mint font-mono text-[11px] border border-emerald-500/20 dark:border-nahida-mint/20">
                  <span>📜 {row.book.count}x {row.book.name}</span>
                </span>

                <!-- Boss Material if any -->
                {row.boss && (
                  <span class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-purple-500/10 dark:bg-purple-400/10 text-purple-900 dark:text-purple-300 font-mono text-[11px] border border-purple-500/20">
                    <span>⚡ {row.boss.count}x {row.boss.name}</span>
                  </span>
                )}

                <!-- Crown if any -->
                {row.crown && (
                  <span class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-amber-500/15 dark:bg-nahida-gold/15 text-amber-900 dark:text-nahida-gold font-mono text-[11px] font-bold border border-amber-500/30">
                    <span>👑 {row.crown.count}x {row.crown.name}</span>
                  </span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Total Cost for One Talent (1 -> 10) Grid -->
      <div class="reveal-on-scroll p-4 sm:p-8 rounded-3xl glass-panel border border-sumeru-200/60 dark:border-white/[0.08] shadow-md mb-8">
        <h3 class="font-display font-bold text-lg text-sumeru-950 dark:text-white mb-1 flex items-center gap-2">
          <span class="text-sumeru-600 dark:text-nahida-mint">❖</span>
          <span>Total Cost (1 → 10 for One Talent)</span>
        </h3>
        <p class="text-xs font-mono text-sumeru-600 dark:text-nahida-mint/80 mb-6">
          Multiply by 3 to triple-crown all of Nahida's talents
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2.5 sm:gap-3">
          {totalTalentCost.map((mat) => (
            <div class="p-2.5 sm:p-3.5 rounded-2xl bg-white/60 dark:bg-black/25 border border-sumeru-200/60 dark:border-white/[0.08] flex items-center gap-2.5 sm:gap-3 hover:border-sumeru-400 dark:hover:border-nahida-mint/40 transition-all group">
              <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-sumeru-100 dark:bg-sumeru-900/60 p-1 sm:p-1.5 shrink-0 flex items-center justify-center border border-sumeru-200/50 dark:border-white/10 group-hover:scale-105 transition-transform">
                {mat.icon ? (
                  <img src={mat.icon} alt={mat.name} class="w-full h-full object-contain" />
                ) : (
                  <span class="font-mono text-xs font-bold text-sumeru-700 dark:text-nahida-mint">
                    {mat.badge === 'Crown' ? '👑' : '📜'}
                  </span>
                )}
              </div>
              <div class="min-w-0 flex-1">
                <div class="font-mono font-bold text-sm sm:text-base text-sumeru-950 dark:text-white leading-tight">
                  {mat.count}
                </div>
                <div class="text-[11px] sm:text-xs text-sumeru-700 dark:text-nahida-light/80 leading-snug mt-0.5 break-words">
                  {mat.name}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>


    </div>

    <!-- 5. Availability Section -->
    <div id="section-availability" class="mb-20 scroll-mt-24">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-mono uppercase tracking-widest text-sumeru-600 dark:text-nahida-mint mb-2 block">
          Event Wishes
        </span>
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-sumeru-950 dark:text-white">
          Availability
        </h2>
      </div>

      <div class="space-y-8">
        <!-- Event Wishes Card -->
        <div class="reveal-on-scroll p-6 sm:p-8 rounded-3xl glass-panel border border-sumeru-200/60 dark:border-white/[0.08] shadow-md">
          <h3 class="font-display font-bold text-lg text-sumeru-950 dark:text-white mb-2 flex items-center gap-2">
            <span class="text-sumeru-600 dark:text-nahida-mint">❖</span>
            <span>Character Event Wishes</span>
          </h3>
          <p class="text-sm text-sumeru-800/80 dark:text-nahida-light/80 mb-6">
            Nahida has been promoted or featured with a drop-rate boost in 5 Event Wishes:
          </p>
          <div class="rounded-2xl overflow-hidden bg-black/5 dark:bg-black/40 p-3 sm:p-6 flex items-center justify-center border border-sumeru-200/40 dark:border-white/5">
            <img
              src="/images/nahida_banners.jpeg"
              alt="All Nahida banners up to now"
              class="max-w-full max-h-[580px] w-auto h-auto object-contain rounded-xl shadow-sm"
              loading="lazy"
            />
          </div>
          <figcaption class="text-xs italic text-center text-sumeru-600 dark:text-nahida-mint/70 mt-3 font-mono">
            All Nahida banners up to now.
          </figcaption>
        </div>

        <!-- Chronicled Wishes Card -->
        <div class="reveal-on-scroll p-6 rounded-3xl glass-panel border border-sumeru-200/60 dark:border-white/[0.08]">
          <h3 class="font-display font-bold text-base text-sumeru-950 dark:text-white mb-1.5 flex items-center gap-2">
            <span class="text-sumeru-600 dark:text-nahida-mint">❖</span>
            <span>Chronicled Wishes</span>
          </h3>
          <p class="text-sm text-sumeru-800/80 dark:text-nahida-light/80">
            Nahida has not been included in any Chronicled Wishes.
          </p>
        </div>
      </div>
    </div>

    <!-- 6. Languages Section: REAL TABLE -->
    <div id="section-languages" class="mb-20 scroll-mt-24">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-mono uppercase tracking-widest text-sumeru-600 dark:text-nahida-mint mb-2 block">
          Localization & Voice Cast
        </span>
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-sumeru-950 dark:text-white">
          Languages
        </h2>
        <p class="text-sm text-sumeru-800/80 dark:text-nahida-light/80 mt-2">
          Official character names and localization across all supported game languages.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Official Names Real Table -->
        <div class="lg:col-span-8 reveal-on-scroll p-4 sm:p-8 rounded-3xl glass-panel border border-sumeru-200/60 dark:border-white/[0.08] shadow-lg">
          <div class="flex items-center justify-between mb-6 pb-4 border-b border-sumeru-200/50 dark:border-white/[0.08]">
            <h3 class="font-display font-bold text-lg text-sumeru-950 dark:text-white flex items-center gap-2">
              <span class="text-sumeru-600 dark:text-nahida-mint">❖</span>
              <span>Official Localization Names</span>
            </h3>
            <span class="text-xs font-mono text-sumeru-600 dark:text-nahida-mint/80">
              15 Languages
            </span>
          </div>

          <!-- Desktop Table View (>= sm screens) -->
          <div class="hidden sm:block overflow-x-auto rounded-2xl border border-sumeru-200/70 dark:border-white/[0.08]">
            <table class="w-full text-left text-xs border-collapse">
              <thead>
                <tr class="bg-sumeru-100/90 dark:bg-sumeru-950/70 text-sumeru-900 dark:text-nahida-mint font-mono font-semibold border-b border-sumeru-200 dark:border-white/10 uppercase tracking-wider">
                  <th class="py-3 px-4">Language</th>
                  <th class="py-3 px-4">Official Name</th>
                  <th class="py-3 px-4">Romanization / Script</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-sumeru-200/50 dark:divide-white/[0.05]">
                {languagesData.map((item) => (
                  <tr class="hover:bg-emerald-500/5 dark:hover:bg-nahida-mint/5 transition-colors">
                    <td class="py-2.5 px-4 font-mono font-medium text-sumeru-900 dark:text-white">
                      {item.language}
                    </td>
                    <td class="py-2.5 px-4 font-display font-semibold text-sm text-sumeru-950 dark:text-white">
                      {item.name}
                    </td>
                    <td class="py-2.5 px-4 font-mono text-xs text-emerald-700 dark:text-nahida-mint">
                      {item.romanization ? item.romanization : <span class="text-sumeru-400 dark:text-white/20">—</span>}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <!-- Mobile Card View (< sm screens): Fits screen horizontally without slide/scroll -->
          <div class="block sm:hidden space-y-2">
            {languagesData.map((item) => (
              <div class="p-3 rounded-2xl bg-white/70 dark:bg-black/30 border border-sumeru-200/60 dark:border-white/[0.06] flex items-center justify-between">
                <div class="min-w-0 pr-2">
                  <span class="text-[10px] font-mono uppercase tracking-wider text-sumeru-500 dark:text-nahida-mint/70 block">
                    {item.language}
                  </span>
                  <span class="font-display font-semibold text-sm text-sumeru-950 dark:text-white block mt-0.5">
                    {item.name}
                  </span>
                </div>
                {item.romanization ? (
                  <span class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-emerald-500/10 dark:bg-nahida-mint/10 text-emerald-800 dark:text-nahida-mint shrink-0">
                    {item.romanization}
                  </span>
                ) : (
                  <span class="text-[11px] font-mono text-sumeru-400 dark:text-white/20 shrink-0">
                    —
                  </span>
                )}
              </div>
            ))}
          </div>
        </div>

        <!-- Voice Actors Side Card -->
        <div class="lg:col-span-4 reveal-on-scroll p-6 rounded-3xl glass-panel border border-sumeru-200/60 dark:border-white/[0.08] shadow-md space-y-6">
          <div>
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono bg-sumeru-100 dark:bg-nahida-mint/10 text-sumeru-800 dark:text-nahida-mint mb-2">
              CASTING
            </div>
            <h3 class="font-display font-bold text-lg text-sumeru-950 dark:text-white">
              Official Voice Actors
            </h3>
            <p class="text-xs text-sumeru-700 dark:text-nahida-light/75 mt-1 leading-relaxed">
              The vocal talents bringing Lesser Lord Kusanali to life across major game voiceovers.
            </p>
          </div>

          <div class="space-y-3">
            {voiceActors.map((va) => (
              <div class="p-3.5 rounded-2xl bg-white/60 dark:bg-black/25 border border-sumeru-200/50 dark:border-white/[0.06] flex items-center justify-between">
                <div>
                  <span class="text-[10px] font-mono text-sumeru-500 dark:text-nahida-mint/70 uppercase tracking-wider block">
                    {va.region}
                  </span>
                  <div class="font-display font-semibold text-sm text-sumeru-950 dark:text-white mt-0.5">
                    {va.actor}
                  </div>
                </div>
                <span class="text-xs text-sumeru-400 dark:text-nahida-mint/40">🎙️</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Quote Banner -->
    <div class="rounded-3xl p-8 sm:p-10 glass-panel border border-sumeru-300/50 dark:border-nahida-mint/20 text-center relative overflow-hidden">
      <div class="relative z-10 max-w-2xl mx-auto space-y-4">
        <div class="w-10 h-10 mx-auto text-sumeru-600 dark:text-nahida-mint opacity-60">
          <svg fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
        </div>
        <p class="font-display text-lg sm:text-xl text-sumeru-950 dark:text-white italic leading-relaxed">
          "The world will forget me... but wisdom, once shared, lives on forever in the stories of those who learn."
        </p>
        <span class="text-xs font-mono text-sumeru-600 dark:text-nahida-mint/80 uppercase tracking-widest block">
          — Greater Lord Rukkhadevata & Nahida
        </span>
      </div>
    </div>

  </div>
</BaseLayout>
