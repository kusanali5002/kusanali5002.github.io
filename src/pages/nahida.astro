    icon: '/images/Nahida_Constellation_2.webp',
    originalImage: '/images/nahida_c2_image.jpeg',
    desc: 'Opponents that are marked by Seeds of Skandha applied by Nahida herself will be affected by the following effects:\n• Burning, Bloom, Hyperbloom, and Burgeon Reaction DMG can score CRIT Hits. CRIT Rate and CRIT DMG are fixed at 20% and 100% respectively.\n• Within 8s of being affected by Quicken, Aggravate, Spread, DEF is decreased by 30%.'
  },
  {
    num: 'C3',
    name: 'The Shoot of Conscious Attainment',
    icon: '/images/Nahida_Constellation_3.webp',
    originalImage: '/images/nahida_c3_image.jpeg',
    desc: 'Increases the Level of All Schemes to Know by 3. Maximum upgrade level is 15.'
  },
  {
    num: 'C4',
    name: 'The Stem of Manifest Inference',
    icon: '/images/Nahida_Constellation_4.webp',
    originalImage: '/images/nahida_c4_image.jpeg',
    desc: "When 1/2/3/(4 or more) nearby opponents are affected by All Schemes to Know's Seeds of Skandha, Nahida's Elemental Mastery will be increased by 100/120/140/160."
  },
  {
    num: 'C5',
    name: 'The Leaves of Enlightening Speech',
    icon: '/images/Nahida_Constellation_5.webp',
    originalImage: '/images/nahida_c5_image.jpeg',
    desc: 'Increases the Level of Illusory Heart by 3. Maximum upgrade level is 15.'
  },
  {
    num: 'C6',
    name: "The Fruit of Reason's Culmination",
    icon: '/images/Nahida_Constellation_6.webp',
    originalImage: '/images/nahida_c6_image.jpeg',
    desc: "When Nahida hits an opponent affected by All Schemes to Know's Seeds of Skandha with Normal or Charged Attacks after unleashing Illusory Heart, she will use Tri-Karma Purification: Karmic Oblivion on this opponent and all connected opponents, dealing Dendro DMG based on 200% of Nahida's ATK and 400% of her Elemental Mastery.\n\nDMG dealt is considered Elemental Skill DMG and can be triggered every 0.2s. This effect lasts up to 10s or until 6 instances are triggered."
  }
];

