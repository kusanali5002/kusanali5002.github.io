          'act-search-placeholder': 'Tìm kiếm bài viết theo tiêu đề, thẻ, hoặc chủ đề...',
          'act-empty-title':        'Không tìm thấy hoạt động nào',
          'act-empty-desc':         'Hãy thử thay đổi từ khóa tìm kiếm hoặc chọn một thể loại khác ở trên.',
          'card-reading-time':      '{n} phút đọc',
        }
