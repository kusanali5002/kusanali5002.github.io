---
import SEO from '../components/common/SEO.astro';
import DynamicGradient from '../components/common/DynamicGradient.astro';
import CustomCursor from '../components/common/CustomCursor.astro';
import Navbar from '../components/common/Navbar.astro';
import MobileNav from '../components/common/MobileNav.astro';
import Footer from '../components/common/Footer.astro';
import ProjectModal from '../components/workspace/ProjectModal.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/animations.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  section?: 'home' | 'activities' | 'workspace' | 'nahida' | 'about' | 'contact';
}

const {
  title,
  description,
  image,
  type = 'website',
  publishedTime,
  section = 'home',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
    />

    <ClientRouter />

    <!-- Directional Navigation Slide Detection & Theme Synchronization -->
    <script is:inline>
      (function() {
        const navOrder = [
          '/',
          '/activities',
          '/workspace',
          '/nahida',
          '/about',
          '/contact'
        ];

        function getNavIndex(urlPath) {
          if (!urlPath) return -1;
          const clean = urlPath.replace(/\/$/, '') || '/';
          for (let i = navOrder.length - 1; i >= 0; i--) {
            const item = navOrder[i];
            if (item === '/' && clean === '/') return 0;
            if (item !== '/' && (clean === item || clean.startsWith(item + '/'))) return i;
          }
          return -1;
        }

        function isPageTranslated(urlPath) {
          const clean = (urlPath || '').replace(/\/$/, '') || '/';
          return clean === '/' || clean === '/activities' || clean === '/nahida' || clean === '/about';
        }

        // Immediate check on initial cold load:
        // Ensure that on first visit / new session, language always defaults to English (ENG)
        if (!sessionStorage.getItem('site-session')) {
          sessionStorage.setItem('site-session', '1');
          localStorage.setItem('site-lang', 'en');
        }

        const initialPath = (window.location.pathname || '').replace(/\/$/, '') || '/';
        if (!isPageTranslated(initialPath) && localStorage.getItem('site-lang') === 'vn') {
          document.documentElement.classList.add('pending-vn-modal');
          document.documentElement.classList.add('hide-page-content');
          localStorage.setItem('site-lang', 'en');
        }

        document.addEventListener('astro:before-preparation', (event) => {
          const fromIdx = getNavIndex(event.from.pathname);
          const toIdx = getNavIndex(event.to.pathname);

          if (fromIdx !== -1 && toIdx !== -1 && fromIdx !== toIdx) {
            if (toIdx < fromIdx) {
              // Navigating to the left tab in the header bar
              document.documentElement.dataset.slideDirection = 'left';
            } else {
              // Navigating to the right tab in the header bar
              document.documentElement.dataset.slideDirection = 'right';
            }
          } else {
            document.documentElement.dataset.slideDirection = 'fade';
          }

          // Pre-transition check: show notification before new page content loads
          const toPath = (event.to.pathname || '').replace(/\/$/, '') || '/';
          const isVN = localStorage.getItem('site-lang') === 'vn';
          if (!isPageTranslated(toPath) && isVN) {
            localStorage.setItem('site-lang', 'en');
            document.documentElement.classList.add('hide-page-content');
            const banner = document.getElementById('vn-notify-banner');
            if (banner) {
              banner.style.display = 'flex';
            }
            if (typeof window.applyLang === 'function') {
              window.applyLang('en');
            }
          }
        });

        function syncTheme() {
          const storedTheme = localStorage.getItem('theme');
          const userPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (storedTheme === 'dark' || (!storedTheme && userPrefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }

        syncTheme();
        document.addEventListener('astro:before-swap', (event) => {
          const storedTheme = localStorage.getItem('theme');
          const userPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (storedTheme === 'dark' || (!storedTheme && userPrefersDark)) {
            event.newDocument.documentElement.classList.add('dark');
          } else {
            event.newDocument.documentElement.classList.remove('dark');
          }

          const toPath = (window.location.pathname || '').replace(/\/$/, '') || '/';
          const isVN = localStorage.getItem('site-lang') === 'vn';
          if (!isPageTranslated(toPath) && isVN) {
            localStorage.setItem('site-lang', 'en');
            event.newDocument.documentElement.classList.add('hide-page-content');
            const banner = document.getElementById('vn-notify-banner');
            if (banner) banner.style.display = 'flex';
          }
        });
        document.addEventListener('astro:after-swap', () => {
          syncTheme();
          const current = (window.location.pathname || '').replace(/\/$/, '') || '/';
          if (isPageTranslated(current)) {
            document.documentElement.classList.remove('hide-page-content');
          }
        });
      })();
    </script>
  </head>
  <body id="top" class="selection:bg-sumeru-400/30 selection:text-sumeru-950 dark:selection:bg-nahida-mint/30 dark:selection:text-nahida-mint">
    <!-- Ambient Dynamic Gradient Canvas -->
    <div transition:persist="dynamic-gradient">
      <DynamicGradient />
    </div>

    <!-- Desktop Custom Cursor -->
    <div transition:persist="custom-cursor">
      <CustomCursor />
    </div>

    <!-- Navigation Header (Completely static and persistent) -->
    <Navbar />
    <MobileNav />

    <!-- Lightbox Modal (Elevated root level above header, persistent across transitions) -->
    <div transition:persist="project-lightbox">
      <ProjectModal />
    </div>

    <!-- VN Notification Modal (Persistent across transitions, elevated root level) -->
    <div transition:persist="vn-notification">
      <div
        id="vn-notify-banner"
        style="display:none"
        class="fixed inset-0 z-[9999] flex items-center justify-center p-4 sm:p-6 bg-black/60 backdrop-blur-md transition-all duration-300 vn-modal-backdrop"
        role="alertdialog"
        aria-modal="true"
        aria-label="Thông báo bản dịch"
      >
        <div
          class="relative w-full max-w-md sm:max-w-lg p-6 sm:p-8 rounded-3xl bg-white/95 dark:bg-[#122419]/95 border-2 border-sumeru-400 dark:border-nahida-mint/50 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.4)] dark:shadow-[0_0_60px_rgba(126,232,176,0.22)] backdrop-blur-2xl text-center flex flex-col items-center gap-5 vn-modal-card"
        >
          <!-- Sleeping Nahida animated GIF -->
          <div class="w-28 h-28 sm:w-32 sm:h-32 flex items-center justify-center flex-shrink-0">
            <img
              src="/images/MYDWCT_Nahida_Sleep.gif"
              alt="Nahida Sleeping"
              class="w-full h-full object-contain filter drop-shadow-md"
              loading="eager"
            />
          </div>

          <p class="text-base sm:text-lg font-medium text-sumeru-900 dark:text-white leading-relaxed max-w-sm mx-auto">
            Bản dịch tiếng Việt đang trong quá trình hoàn thiện
          </p>

          <button
            id="vn-notify-ok"
            class="w-full sm:w-auto px-10 py-3 rounded-2xl text-sm font-bold uppercase tracking-wider bg-sumeru-600 dark:bg-nahida-mint text-white dark:text-sumeru-950 hover:bg-sumeru-700 dark:hover:bg-white hover:scale-105 active:scale-95 transition-all shadow-lg cursor-pointer"
          >
            OK
          </button>
        </div>
      </div>
    </div>

    <!-- Page Content Container (Slides on navigation, leaving header untouched) -->
    <div id="page-content" class="flex-grow flex flex-col w-full min-h-screen">
      <!-- Main Content Container with section attribute for gradient matching -->
      <main id="main-content" class="flex-grow pt-24 sm:pt-28 relative z-10" data-section={section}>
        <slot />
      </main>

      <!-- Site Footer -->
      <Footer />
    </div>

    <!-- Global Scroll-Reveal Observer -->
    <script>
      function setupScrollReveal() {
        const elements = document.querySelectorAll('.reveal-on-scroll');
        if (elements.length === 0) return;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          elements.forEach(el => el.classList.add('is-revealed'));
          return;
        }

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          });
        }, {
          root: null,
          rootMargin: '0px 0px -40px 0px',
          threshold: 0.1,
        });

        elements.forEach(el => observer.observe(el));
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupScrollReveal);
      } else {
        setupScrollReveal();
      }

      document.addEventListener('astro:after-swap', setupScrollReveal);
    </script>

    <!-- i18n Engine -->
