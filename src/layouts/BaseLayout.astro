---
import SEO from '../components/common/SEO.astro';
import DynamicGradient from '../components/common/DynamicGradient.astro';
import CustomCursor from '../components/common/CustomCursor.astro';
import Navbar from '../components/common/Navbar.astro';
import MobileNav from '../components/common/MobileNav.astro';
import Footer from '../components/common/Footer.astro';
import ProjectModal from '../components/workspace/ProjectModal.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/animations.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  section?: 'home' | 'activities' | 'workspace' | 'nahida' | 'about' | 'contact';
}

const {
  title,
  description,
  image,
  type = 'website',
  publishedTime,
  section = 'home',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
    />

    <ClientRouter />

    <!-- Directional Navigation Slide Detection & Theme Synchronization -->
    <script is:inline>
      (function() {
        const navOrder = [
          '/',
          '/activities',
          '/workspace',
          '/nahida',
          '/about',
          '/contact'
        ];

        function getNavIndex(urlPath) {
          if (!urlPath) return -1;
          const clean = urlPath.replace(/\/$/, '') || '/';
          for (let i = navOrder.length - 1; i >= 0; i--) {
            const item = navOrder[i];
            if (item === '/' && clean === '/') return 0;
            if (item !== '/' && (clean === item || clean.startsWith(item + '/'))) return i;
          }
          return -1;
        }

        function isPageTranslated(urlPath) {
          const clean = (urlPath || '').replace(/\/$/, '') || '/';
          return clean === '/' || clean === '/activities' || clean === '/nahida' || clean === '/about';
        }

        if (!sessionStorage.getItem('site-session')) {
          sessionStorage.setItem('site-session', '1');
          localStorage.setItem('site-lang', 'en');
        }

        const initialPath = (window.location.pathname || '').replace(/\/$/, '') || '/';
        if (!isPageTranslated(initialPath) && localStorage.getItem('site-lang') === 'vn') {
          document.documentElement.classList.add('pending-vn-modal');
          document.documentElement.classList.add('hide-page-content');
          localStorage.setItem('site-lang', 'en');
        }

        document.addEventListener('astro:before-preparation', (event) => {
          const fromIdx = getNavIndex(event.from.pathname);
          const toIdx = getNavIndex(event.to.pathname);

          if (fromIdx !== -1 && toIdx !== -1 && fromIdx !== toIdx) {
            if (toIdx < fromIdx) {
              // Navigating to the left tab in the header bar
              document.documentElement.dataset.slideDirection = 'left';
            } else {
              // Navigating to the right tab in the header bar
              document.documentElement.dataset.slideDirection = 'right';
            }
          } else {
            document.documentElement.dataset.slideDirection = 'fade';
          }

          const toPath = (event.to.pathname || '').replace(/\/$/, '') || '/';
          const isVN = localStorage.getItem('site-lang') === 'vn';
          if (!isPageTranslated(toPath) && isVN) {
            localStorage.setItem('site-lang', 'en');
            document.documentElement.classList.add('hide-page-content');
            const banner = document.getElementById('vn-notify-banner');
            if (banner) banner.style.display = 'flex';
            if (typeof window.applyLang === 'function') window.applyLang('en');
          }
        });

        function syncTheme() {
          const storedTheme = localStorage.getItem('theme');
          const userPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (storedTheme === 'dark' || (!storedTheme && userPrefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }

        syncTheme();
        document.addEventListener('astro:before-swap', (event) => {
          const storedTheme = localStorage.getItem('theme');
          const userPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (storedTheme === 'dark' || (!storedTheme && userPrefersDark)) {
            event.newDocument.documentElement.classList.add('dark');
          } else {
            event.newDocument.documentElement.classList.remove('dark');
          }

          const toPath = (window.location.pathname || '').replace(/\/$/, '') || '/';
          const isVN = localStorage.getItem('site-lang') === 'vn';
          if (!isPageTranslated(toPath) && isVN) {
            localStorage.setItem('site-lang', 'en');
            event.newDocument.documentElement.classList.add('hide-page-content');
            const banner = document.getElementById('vn-notify-banner');
            if (banner) banner.style.display = 'flex';
          }
        });
        document.addEventListener('astro:after-swap', () => {
          syncTheme();
          const current = (window.location.pathname || '').replace(/\/$/, '') || '/';
          if (isPageTranslated(current)) {
            document.documentElement.classList.remove('hide-page-content');
          }
        });
      })();
    </script>
  </head>
  <body id="top" class="selection:bg-sumeru-400/30 selection:text-sumeru-950 dark:selection:bg-nahida-mint/30 dark:selection:text-nahida-mint">
    <!-- Ambient Dynamic Gradient Canvas -->
    <div transition:persist="dynamic-gradient">
      <DynamicGradient />
    </div>

    <!-- Desktop Custom Cursor -->
    <div transition:persist="custom-cursor">
      <CustomCursor />
    </div>

    <!-- Navigation Header (Completely static and persistent) -->
    <Navbar />
    <MobileNav />

    <!-- Lightbox Modal (Elevated root level above header) -->
    <div transition:persist="project-lightbox">
      <ProjectModal />
    </div>

    <!-- VN Notification Modal (Persistent across transitions, elevated root level) -->
    <div transition:persist="vn-notification">
      <div
        id="vn-notify-banner"
        style="display:none"
        class="fixed inset-0 z-[9999] flex items-center justify-center p-4 sm:p-6 bg-black/60 backdrop-blur-md transition-all duration-300 vn-modal-backdrop"
        role="alertdialog"
        aria-modal="true"
        aria-label="Thông báo bản dịch"
      >
        <div
          class="relative w-full max-w-md sm:max-w-lg p-6 sm:p-8 rounded-[11px] bg-white/95 dark:bg-[#122419]/95 border-2 border-sumeru-400 dark:border-nahida-mint/50 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.4)] dark:shadow-[0_0_60px_rgba(126,232,176,0.22)] backdrop-blur-2xl text-center flex flex-col items-center gap-5 vn-modal-card"
        >
          <!-- Sleeping Nahida animated GIF -->
          <div class="w-28 h-28 sm:w-32 sm:h-32 flex items-center justify-center flex-shrink-0">
            <img
              src="/images/MYDWCT_Nahida_Sleep.gif"
              alt="Nahida Sleeping"
              class="w-full h-full object-contain filter drop-shadow-md"
              loading="eager"
            />
          </div>

          <p class="text-base sm:text-lg font-medium text-sumeru-900 dark:text-white leading-relaxed max-w-sm mx-auto">
            Bản dịch tiếng Việt đang trong quá trình hoàn thiện
          </p>

          <button
            id="vn-notify-ok"
            class="w-full sm:w-auto px-10 py-3 rounded-[11px] text-sm font-bold uppercase tracking-wider bg-sumeru-600 dark:bg-nahida-mint text-white dark:text-sumeru-950 hover:bg-sumeru-700 dark:hover:bg-white hover:scale-105 active:scale-95 transition-all shadow-lg cursor-pointer"
          >
            OK
          </button>
        </div>
      </div>
    </div>

    <!-- Page Content Container (Slides on navigation, leaving header untouched) -->
    <div id="page-content" class="flex-grow flex flex-col w-full min-h-screen">
      <!-- Main Content Container with section attribute for gradient matching -->
      <main id="main-content" class="flex-grow pt-24 sm:pt-28 relative z-10" data-section={section}>
        <slot />
      </main>

      <!-- Site Footer -->
      <Footer />
    </div>

    <!-- Global Scroll-Reveal Observer -->
    <script>
      function setupScrollReveal() {
        const elements = document.querySelectorAll('.reveal-on-scroll');
        if (elements.length === 0) return;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          elements.forEach(el => el.classList.add('is-revealed'));
          return;
        }

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          });
        }, {
          root: null,
          rootMargin: '0px 0px -40px 0px',
          threshold: 0.1,
        });

        elements.forEach(el => observer.observe(el));
      }

      let carouselCleanups = [];

      function cleanupSwipeCarousels() {
        carouselCleanups.forEach((fn) => fn());
        carouselCleanups = [];
      }

      function setupSwipeCarousels() {
        cleanupSwipeCarousels();
        const carousels = document.querySelectorAll('.swipe-carousel');
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const SVG_NS = 'http://www.w3.org/2000/svg';

        carousels.forEach((carousel) => {
          let scrollBarTimer;
          let scrollEndTimer;
          let activeIndex = 0;
          let isVisible = false;
          let isHolding = false;
          let activeOverlay = null;
          let activeRect = null;

          const slides = Array.from(carousel.querySelectorAll('.swipe-slide'));
          const durationMs = parseInt(carousel.dataset.autoAdvance || '0', 10);
          const section = carousel.closest('[data-carousel-section]');
          const prevBtn = section ? section.querySelector('[data-carousel-prev]') : null;
          const nextBtn = section ? section.querySelector('[data-carousel-next]') : null;

          const isCarouselActive = () => slides.length > 1;

          function clearBorder() {
            if (activeOverlay && activeOverlay.parentNode) {
              activeOverlay.remove();
            }
            activeOverlay = null;
            activeRect = null;
          }

          function getCurrentSlideIndex() {
            const width = carousel.clientWidth;
            if (!width) return 0;
            return Math.max(0, Math.min(slides.length - 1, Math.round(carousel.scrollLeft / width)));
          }

          function goToSlide(targetIndex) {
            const wrapped = (targetIndex + slides.length) % slides.length;
            activeIndex = wrapped;
            clearBorder();
            carousel.scrollTo({
              left: wrapped * carousel.clientWidth,
              behavior: 'smooth',
            });
            clearTimeout(scrollEndTimer);
            scrollEndTimer = setTimeout(() => {
              activeIndex = getCurrentSlideIndex();
              startCircuitForSlide(activeIndex);
            }, 450);
          }

          function startCircuitForSlide(index) {
            clearBorder();
            if (!durationMs || prefersReducedMotion || !isCarouselActive() || !isVisible) return;

            const slide = slides[index];
            if (!slide) return;
            const w = slide.offsetWidth;
            const h = slide.offsetHeight;
            if (!w || !h) return;

            const svg = document.createElementNS(SVG_NS, 'svg');
            svg.setAttribute('class', 'swipe-border-overlay');
            svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
            svg.setAttribute('aria-hidden', 'true');

            const rect = document.createElementNS(SVG_NS, 'rect');
            rect.setAttribute('class', 'swipe-border-rect');
            rect.setAttribute('x', '1.5');
            rect.setAttribute('y', '1.5');
            rect.setAttribute('width', String(Math.max(0, w - 3)));
            rect.setAttribute('height', String(Math.max(0, h - 3)));
            const radius = window.matchMedia('(min-width: 1024px)').matches ? '11' : '0';
            rect.setAttribute('rx', radius);
            rect.setAttribute('ry', radius);
            rect.setAttribute('pathLength', '100');
            rect.style.animationDuration = `${durationMs}ms`;

            rect.addEventListener('animationend', () => {
              if (!isVisible || !isCarouselActive()) return;
              goToSlide(activeIndex + 1);
            }, { once: true });

            svg.appendChild(rect);
            slide.appendChild(svg);
            activeOverlay = svg;
            activeRect = rect;

            // Force reflow so animation starts cleanly from 100 -> 0 at top-left
            void rect.getBoundingClientRect();
            rect.classList.add('is-running');
            if (isHolding) {
              rect.classList.add('is-paused');
            }
          }

          const onScroll = () => {
            carousel.classList.add('is-scrolling');
            clearTimeout(scrollBarTimer);
            scrollBarTimer = setTimeout(() => {
              carousel.classList.remove('is-scrolling');
            }, 700);

            if (!durationMs || prefersReducedMotion || !isCarouselActive()) return;
            clearTimeout(scrollEndTimer);
            scrollEndTimer = setTimeout(() => {
              const newIndex = getCurrentSlideIndex();
              if (newIndex !== activeIndex || !activeOverlay) {
                activeIndex = newIndex;
                startCircuitForSlide(activeIndex);
              }
            }, 180);
          };

          const onPause = () => {
            isHolding = true;
            if (activeRect) activeRect.classList.add('is-paused');
          };

          const onResume = () => {
            isHolding = false;
            if (activeRect) activeRect.classList.remove('is-paused');
          };

          const hoverTarget = carousel.closest('[data-carousel-wrap]') || carousel;

          const onPrev = (e) => {
            e.stopPropagation();
            goToSlide(activeIndex - 1);
          };
          const onNext = (e) => {
            e.stopPropagation();
            goToSlide(activeIndex + 1);
          };

          const onResize = () => {
            if (!isCarouselActive()) {
              clearBorder();
            } else if (isVisible) {
              activeIndex = getCurrentSlideIndex();
              startCircuitForSlide(activeIndex);
            }
          };

          carousel.addEventListener('scroll', onScroll, { passive: true });
          hoverTarget.addEventListener('mouseenter', onPause, { passive: true });
          hoverTarget.addEventListener('mouseleave', onResume, { passive: true });
          carousel.addEventListener('touchstart', onPause, { passive: true });
          carousel.addEventListener('touchend', onResume, { passive: true });
          carousel.addEventListener('touchcancel', onResume, { passive: true });
          carousel.addEventListener('pointerdown', onPause, { passive: true });
          carousel.addEventListener('pointerup', onResume, { passive: true });
          carousel.addEventListener('pointercancel', onResume, { passive: true });
          prevBtn?.addEventListener('click', onPrev);
          nextBtn?.addEventListener('click', onNext);
          window.addEventListener('resize', onResize, { passive: true });

          const visibilityObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              isVisible = entry.isIntersecting;
              if (isVisible && isCarouselActive()) {
                activeIndex = getCurrentSlideIndex();
                startCircuitForSlide(activeIndex);
              } else {
                clearBorder();
              }
            });
          }, { threshold: 0.4 });

          visibilityObserver.observe(carousel);

          carouselCleanups.push(() => {
            clearTimeout(scrollBarTimer);
            clearTimeout(scrollEndTimer);
            clearBorder();
            visibilityObserver.disconnect();
            carousel.removeEventListener('scroll', onScroll);
            hoverTarget.removeEventListener('mouseenter', onPause);
            hoverTarget.removeEventListener('mouseleave', onResume);
            carousel.removeEventListener('touchstart', onPause);
            carousel.removeEventListener('touchend', onResume);
            carousel.removeEventListener('touchcancel', onResume);
            carousel.removeEventListener('pointerdown', onPause);
            carousel.removeEventListener('pointerup', onResume);
            carousel.removeEventListener('pointercancel', onResume);
            prevBtn?.removeEventListener('click', onPrev);
            nextBtn?.removeEventListener('click', onNext);
            window.removeEventListener('resize', onResize);
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          setupScrollReveal();
          setupSwipeCarousels();
        });
      } else {
        setupScrollReveal();
        setupSwipeCarousels();
      }

      document.addEventListener('astro:before-swap', cleanupSwipeCarousels);
      document.addEventListener('astro:after-swap', () => {
        setupScrollReveal();
        setupSwipeCarousels();
      });
    </script>

