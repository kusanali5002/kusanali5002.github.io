          'header-subtitle':   '<span class="whitespace-nowrap">Trang web chính thức</span><span class="sm:hidden"><br /></span><span class="hidden sm:inline">&nbsp;</span><span class="whitespace-nowrap">của&nbsp;Dun</span>',
          'nav-home':          'TRANG CHỦ',
          'nav-activities':    'HOẠT ĐỘNG',
          'nav-workspace':     'KHÔNG GIAN SÁNG TẠO',
          'nav-nahida':        'NAHIDA',
          'nav-about':         'VỀ DUN',
          'nav-contact':       'LIÊN HỆ',
