      // ─── Apply translations to all [data-i18n] elements ──────────────────
      function applyLang(lang: string) {
        const dict = I18N[lang] || I18N.en;
        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n')!;
          let text = dict[key];
          if (!text) return;
          // Handle {n} placeholder for count-bearing strings
          const count = el.getAttribute('data-count');
          if (count !== null) text = text.replace('{n}', count);
          if (text.includes('<') || text.includes('&')) {
            el.innerHTML = text;
          } else {
            el.textContent = text;
          }
        });
        document.querySelectorAll<HTMLInputElement>('[data-i18n-placeholder]').forEach(el => {
          const key = el.getAttribute('data-i18n-placeholder')!;
          const text = dict[key];
          if (text) el.placeholder = text;
        });
        // Sync toggle label
        const lbl = document.getElementById('lang-toggle-label');
        if (lbl) lbl.textContent = lang === 'vn' ? 'VN' : 'ENG';
      }

      // ─── Language & Notification State Machine ────────────────────────────
      function isTranslatedPage(urlPath?: string) {
        const path = (urlPath || window.location.pathname).replace(/\/$/, '') || '/';
        return path === '/' || path === '/activities' || path === '/nahida' || path === '/about';
      }

      function showVnModal() {
        const banner = document.getElementById('vn-notify-banner');
        if (banner) {
          banner.style.display = 'flex';
        }
      }

      function closeVnModal() {
        document.documentElement.classList.remove('pending-vn-modal');
        document.documentElement.classList.remove('hide-page-content');
        const banner = document.getElementById('vn-notify-banner');
        if (banner) {
          banner.style.display = 'none';
        }
      }

      function handleLangToggle() {
        const currentLang = localStorage.getItem('site-lang') || 'en';
        const isHome = isTranslatedPage();

        if (currentLang === 'en') {
          // User is trying to switch to VN
          if (isHome) {
            // Home has full VN translation -> switch smoothly
            localStorage.setItem('site-lang', 'vn');
            applyLang('vn');
          } else {
            // Untranslated page: hide content, show modal, keep in English
            document.documentElement.classList.add('hide-page-content');
            localStorage.setItem('site-lang', 'en');
            applyLang('en');
            showVnModal();
          }
        } else {
          // Currently in VN (on Home), switch back to English
          localStorage.setItem('site-lang', 'en');
          applyLang('en');
        }
      }

      function setupVnModalEvents() {
        if ((window as any).__vnModalEventsBound) return;
        (window as any).__vnModalEventsBound = true;

        document.addEventListener('click', (e) => {
          const target = e.target as HTMLElement | null;
          if (!target) return;
          if (target.closest('#vn-notify-ok') || target.id === 'vn-notify-banner') {
            e.preventDefault();
            closeVnModal();
          }
        });

        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeVnModal();
        });
      }

      // ─── Boot on every page load & navigation ─────────────────────────────
      function bootI18n() {
        setupVnModalEvents();

        if (!sessionStorage.getItem('site-session')) {
          sessionStorage.setItem('site-session', '1');
          localStorage.setItem('site-lang', 'en');
        }

        const currentLang = localStorage.getItem('site-lang') || 'en';
        const isHome = isTranslatedPage();

        if (isHome) {
          document.documentElement.classList.remove('hide-page-content');
          applyLang(currentLang);
        } else if (currentLang === 'vn') {
          // User navigated from VN page (Home) to an untranslated page:
          // Keep content hidden until user clicks OK on the notification!
          document.documentElement.classList.add('hide-page-content');
          localStorage.setItem('site-lang', 'en');
          applyLang('en');
          showVnModal();
        } else {
          // Normal load in ENG
          const banner = document.getElementById('vn-notify-banner');
          const isModalOpen = banner && banner.style.display === 'flex';
          if (!isModalOpen) {
            document.documentElement.classList.remove('hide-page-content');
          }
          applyLang(currentLang);
        }
      }

      // Expose globally so LanguageToggle and any link can call them
      (window as any).applyLang = applyLang;
      (window as any).handleLangToggle = handleLangToggle;
      (window as any).showVnModal = showVnModal;
      (window as any).closeVnModal = closeVnModal;

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bootI18n);
      } else {
        bootI18n();
      }
      document.addEventListener('astro:page-load', bootI18n);
    </script>
  </body>
</html>
