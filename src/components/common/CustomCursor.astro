---
---
<div
  id="custom-cursor"
  class="pointer-events-none fixed top-0 left-0 z-[10000] hidden md:block opacity-0 will-change-transform"
  aria-hidden="true"
>
  <img
    data-cursor="normal"
    src="/cursors/normal.webp"
    alt=""
    width="32"
    height="32"
    class="nahida-cursor-img block w-8 h-8 select-none"
    decoding="async"
  />
  <img
    data-cursor="link"
    src="/cursors/link.webp"
    alt=""
    width="32"
    height="32"
    class="nahida-cursor-img hidden w-8 h-8 select-none"
    decoding="async"
  />
  <img
    data-cursor="text"
    src="/cursors/text.webp"
    alt=""
    width="32"
    height="32"
    class="nahida-cursor-img hidden w-8 h-8 select-none"
    decoding="async"
  />
  <img
    data-cursor="loading"
    src="/cursors/loading.webp"
    alt=""
    width="32"
    height="32"
    class="nahida-cursor-img hidden w-8 h-8 select-none"
    decoding="async"
  />
</div>

<style is:global>
  .nahida-cursor-img {
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  @media (hover: hover) and (pointer: fine) {
    html.nahida-cursor-active,
    html.nahida-cursor-active * {
      cursor: none !important;
    }
  }

  @media (hover: none), (pointer: coarse) {
    #custom-cursor {
      display: none !important;
    }
  }
</style>

<script>
  function setupCustomCursor() {
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      return;
    }

    const cursor = document.getElementById('custom-cursor');
    if (!cursor || (window as any).__customCursorInitialized) return;
    (window as any).__customCursorInitialized = true;

    document.documentElement.classList.add('nahida-cursor-active');

    const imgs: Record<string, HTMLImageElement | null> = {
      normal: cursor.querySelector('[data-cursor="normal"]'),
      link: cursor.querySelector('[data-cursor="link"]'),
      text: cursor.querySelector('[data-cursor="text"]'),
      loading: cursor.querySelector('[data-cursor="loading"]'),
    };

    const hotspots: Record<string, [number, number]> = {
      normal: [0, 0],
      link: [4, 4],
      text: [3, 7],
      loading: [0, 0],
    };

    let currentState = 'normal';
    let lastX = -100;
    let lastY = -100;
    let isVisible = false;

    function updatePosition() {
      const [hx, hy] = hotspots[currentState] || [0, 0];
      cursor!.style.transform = `translate3d(${lastX - hx}px, ${lastY - hy}px, 0)`;
    }

    function setState(next: string) {
      const resolved = document.documentElement.classList.contains('is-nav-loading') ? 'loading' : next;
      if (resolved === currentState) return;
      currentState = resolved;
      for (const [key, img] of Object.entries(imgs)) {
        if (!img) continue;
        img.classList.toggle('hidden', key !== currentState);
        img.classList.toggle('block', key === currentState);
      }
      if (isVisible) updatePosition();
    }

    (window as any).__syncNahidaCursorState = () => {
      setState(document.documentElement.classList.contains('is-nav-loading') ? 'loading' : 'normal');
    };

    window.addEventListener('mousemove', (e) => {
      lastX = e.clientX;
      lastY = e.clientY;
      if (!isVisible) {
        cursor.style.opacity = '1';
        isVisible = true;
      }
      updatePosition();
    }, { passive: true });

    document.addEventListener('mouseleave', () => {
      cursor.style.opacity = '0';
      isVisible = false;
    });

    const clickableSelector = 'a, button, select, summary, [role="button"], .interactive-card, .project-card-trigger, label[for]';
    const textSelector = 'input[type="text"], input[type="search"], input[type="email"], input[type="url"], input[type="password"], textarea, [contenteditable="true"]';

    document.addEventListener('mouseover', (e) => {
      if (document.documentElement.classList.contains('is-nav-loading')) {
        setState('loading');
        return;
      }
      const target = e.target as HTMLElement | null;
      if (!target) return;
      if (target.closest(textSelector)) {
        setState('text');
      } else if (target.closest(clickableSelector)) {
        setState('link');
      } else {
        setState('normal');
      }
    }, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCustomCursor);
  } else {
    setupCustomCursor();
  }
</script>
