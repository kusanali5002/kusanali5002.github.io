---
<button
  id="lang-toggle-btn"
  type="button"
  class="relative px-2.5 py-1.5 rounded-full text-xs font-mono font-semibold text-sumeru-800 dark:text-nahida-mint hover:bg-black/5 dark:hover:bg-white/10 transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-sumeru-500 border border-sumeru-300/50 dark:border-nahida-mint/30 tracking-wider"
  aria-label="Toggle language between English and Vietnamese"
  title="Switch language"
>
  <span id="lang-toggle-label">ENG</span>
</button>

<script>
  function syncToggleLabel() {
    const label = document.getElementById("lang-toggle-label");
    if (label) {
      const current = localStorage.getItem("site-lang") || "en";
      label.textContent = current === "vn" ? "VN" : "ENG";
    }
  }

  if (!(window as any).__langToggleInitialized) {
    (window as any).__langToggleInitialized = true;
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      if (!target?.closest("#lang-toggle-btn")) return;
      e.preventDefault();
      if (typeof (window as any).handleLangToggle === "function") {
        (window as any).handleLangToggle();
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", syncToggleLabel);
  } else {
    syncToggleLabel();
  }
  document.addEventListener("astro:page-load", syncToggleLabel);
</script>
