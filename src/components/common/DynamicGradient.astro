---
---
<div class="ambient-gradient-canvas" aria-hidden="true">
  <!-- Light Mode Nahida Live Wallpaper Background -->
  <video
    id="light-mode-bg-video"
    src="/images/nahida-live-wallpaper.mp4"
    autoplay
    loop
    muted
    playsinline
    preload="auto"
    class="absolute inset-0 w-full h-full object-cover opacity-50 dark:opacity-0 transition-opacity duration-500 pointer-events-none"
    style="filter: contrast(0.82) saturate(0.9) brightness(1.04);"
  ></video>
  <div id="ambient-mesh" class="ambient-gradient-mesh"></div>
</div>
<div class="ambient-noise" aria-hidden="true"></div>

<script>
  function syncBgVideoPlayback() {
    const video = document.getElementById('light-mode-bg-video') as HTMLVideoElement | null;
    if (!video) return;

    const isDark = document.documentElement.classList.contains('dark');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (isDark || reducedMotion || document.hidden) {
      video.pause();
    } else {
      video.play().catch(() => {});
    }
  }

  function setupDynamicGradient() {
    syncBgVideoPlayback();

    if ((window as any).__dynamicGradientInit) return;
    (window as any).__dynamicGradientInit = true;

    // Pause/resume background video on theme toggle or tab visibility change
    const themeObs = new MutationObserver(syncBgVideoPlayback);
    themeObs.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    document.addEventListener('visibilitychange', syncBgVideoPlayback);

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    const mesh = document.getElementById('ambient-mesh');
    if (!mesh) return;

    // GPU-composited transform parallax (zero gradient repaints or blur recomputation)
    let ticking = false;
    function updateGradient() {
      const scrollY = window.scrollY;
      const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      const progress = Math.min(1, Math.max(0, scrollY / maxScroll));

      const tx = Math.sin(progress * Math.PI * 2) * 3.5;
      const ty = (progress - 0.5) * -8;
      mesh!.style.transform = `translate3d(${tx.toFixed(2)}vw, ${ty.toFixed(2)}vh, 0)`;

      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateGradient);
        ticking = true;
      }
    }, { passive: true });

    updateGradient();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupDynamicGradient);
  } else {
    setupDynamicGradient();
  }
</script>
