---
import { formatDate } from '../../utils/formatters';

export interface Props {
  title: string;
  description: string;
  date: string;
  slug: string;
  type: 'social' | 'video' | 'image' | 'gallery' | 'website' | 'project';
  platform?: 'tiktok' | 'youtube' | 'instagram' | 'bilibili' | 'other';
  url?: string;
  thumbnail?: string;
  media?: string;
  poster?: string;
  fallbackVideo?: string;
  images?: string[];
  slides?: Array<{
    type: 'image' | 'video' | 'youtube';
    url: string;
    title?: string;
    poster?: string;
  }>;
  source?: {
    platform: string;
    url: string;
    label?: string;
  };
  tags: string[];
  featured?: boolean;
  aspectRatio?: string;
}

const {
  title,
  description,
  date,
  slug,
  type,
  platform,
  url,
  thumbnail,
  media,
  poster,
  fallbackVideo,
  images = [],
  slides = [],
  source,
  tags = [],
  featured = false,
  aspectRatio = '16:9',
} = Astro.props;

const previewImage = thumbnail || poster || (slides.length > 0 ? slides[0].url : (images.length > 0 ? images[0] : '/images/Nahida_Icon.webp'));

// Type labels and badges
const typeBadgeConfig: Record<string, { label: string; icon: string; colorClass: string }> = {
  social: {
    label: platform ? platform.toUpperCase() : 'SOCIAL',
    icon: '⚡',
    colorClass: 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border-emerald-500/20',
  },
  video: {
    label: 'LOCAL VIDEO',
    icon: '▶',
    colorClass: 'bg-amber-500/10 text-amber-700 dark:text-amber-400 border-amber-500/20',
  },
  gallery: {
    label: `GALLERY (${images.length})`,
    icon: '❖',
    colorClass: 'bg-teal-500/10 text-teal-700 dark:text-teal-400 border-teal-500/20',
  },
  image: {
    label: 'LOCAL WORK',
    icon: '✦',
    colorClass: 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border-emerald-500/20',
  },
  website: {
    label: 'WEB PROJECT',
    icon: '↗',
    colorClass: 'bg-sky-500/10 text-sky-700 dark:text-sky-400 border-sky-500/20',
  },
  project: {
    label: 'LOCAL WORK',
    icon: '✦',
    colorClass: 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border-emerald-500/20',
  },
};

const badge = typeBadgeConfig[type] || typeBadgeConfig.project;
---

<div
  class="workspace-card group interactive-card glass-panel rounded-3xl overflow-hidden flex flex-col h-full border border-sumeru-200/50 dark:border-white/[0.08] transition-all duration-300 cursor-pointer"
  data-title={title.toLowerCase()}
  data-type={type === 'image' ? 'local work' : type}
  data-platform={platform || (type === 'image' ? 'local work' : 'none')}
  data-tags={tags.join(' ').toLowerCase()}
  data-media-type={type}
  data-media-url={url || media || ''}
  data-media-poster={previewImage}
  data-project-title={title}
  data-project-desc={description}
  data-project-platform={platform || (type === 'image' ? 'Local Work' : (source ? source.platform : type))}
  data-external-url={url || (source ? source.url : '')}
  data-cta-label={source?.label || ''}
  data-fallback-video={fallbackVideo || ''}
  data-aspect-ratio={aspectRatio}
  data-gallery-images={JSON.stringify(images)}
  data-slides={JSON.stringify(slides)}
  data-slug={slug}
  data-project-date={formatDate(date)}
  data-project-tags={JSON.stringify(tags)}
>
  <!-- Card Media Viewport (Uniform 16:9 aspect ratio across all post boxes) -->
  <div
    class="relative w-full aspect-video flex-shrink-0 overflow-hidden bg-sumeru-950/20 cursor-pointer project-card-trigger focus:outline-none focus-visible:ring-2 focus-visible:ring-sumeru-500"
    role="button"
    tabindex="0"
    aria-haspopup="dialog"
    aria-label={`Open media preview for ${title}`}
  >
    <img
      src={previewImage}
      alt={title}
      loading="lazy"
      class="w-full h-full object-cover object-center sm:group-hover:scale-105 sm:transition-transform sm:duration-500 sm:ease-out"
      onerror="this.src='/images/Nahida_Icon.webp'"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent opacity-75 sm:group-hover:opacity-60 sm:transition-opacity"></div>

    <!-- Type Badge -->
    <div class="absolute top-4 left-4">
      <span class:list={['inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider sm:backdrop-blur-md border shadow-sm', badge.colorClass]}>
        <span>{badge.icon}</span>
        <span>{badge.label}</span>
      </span>
    </div>

    <!-- Multi-Slide Count Badge -->
    {slides.length > 0 && (
      <div class="absolute top-4 right-4">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-mono font-medium tracking-wider bg-black/60 backdrop-blur-md text-white border border-white/20 shadow-md">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z"/></svg>
          <span>{slides.length} Slides</span>
        </span>
      </div>
    )}

    <!-- Quick Preview / Play Action Icon -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <div class="w-12 h-12 rounded-full bg-white/80 dark:bg-black/70 text-sumeru-950 dark:text-nahida-mint flex items-center justify-center opacity-90 sm:opacity-0 sm:group-hover:opacity-100 sm:backdrop-blur-md shadow-lg">
        {type === 'video' || (type === 'social' && platform === 'youtube') ? (
          <svg class="w-5 h-5 ml-0.5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
        ) : type === 'gallery' ? (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        ) : (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
        )}
      </div>
    </div>

    <!-- Date Overlay on Card Media -->
    <span class="absolute bottom-3 right-4 text-xs font-mono text-white/90 drop-shadow-sm">
      {formatDate(date)}
    </span>
  </div>

  <!-- Card Info Content -->
  <div class="p-5 sm:p-6 flex flex-col flex-1 justify-between">
    <div class="flex-1">
      <h3 class="font-display font-semibold text-base sm:text-lg text-sumeru-950 dark:text-nahida-light group-hover:text-sumeru-600 dark:group-hover:text-nahida-mint transition-colors line-clamp-2 leading-snug mb-2 min-h-[2.75rem] sm:min-h-[3.25rem]">
        {title}
      </h3>
      <p class="text-xs sm:text-sm text-sumeru-800/80 dark:text-nahida-light/70 line-clamp-2 leading-relaxed mb-4 min-h-[2.5rem]" set:html={description} />
    </div>

    <div class="pt-4 border-t border-sumeru-200/40 dark:border-white/[0.05] flex items-center justify-between gap-2 mt-auto">
      <!-- Tags -->
      <div class="flex flex-wrap gap-1.5 items-center">
        {tags.slice(0, 2).map(tag => (
          <span class="px-2 py-0.5 rounded-lg text-[10px] font-medium bg-sumeru-100/70 dark:bg-sumeru-900/40 text-sumeru-800 dark:text-nahida-mint/90">
            #{tag}
          </span>
        ))}
      </div>

      <!-- Action Link / Detail Link -->
      <div class="flex items-center gap-2">
        <a
          href={`/workspace/${slug}/`}
          class="text-xs font-semibold text-sumeru-700 dark:text-nahida-mint hover:underline inline-flex items-center gap-1"
        >
          <span>Explore</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </div>
</div>
