---
import { formatDate } from '../../utils/formatters';
import { isPortraitImage } from '../../utils/imageOrientation';

export interface Props {
  title: string;
  description: string;
  date: string;
  slug: string;
  type: 'social' | 'video' | 'image' | 'gallery' | 'website' | 'project';
  platform?: 'tiktok' | 'youtube' | 'instagram' | 'bilibili' | 'other';
  url?: string;
  thumbnail?: string;
  media?: string;
  poster?: string;
  fallbackVideo?: string;
  images?: string[];
  source?: {
    platform: string;
    url: string;
    label?: string;
  };
  tags: string[];
  featured?: boolean;
  aspectRatio?: string;
  variant?: 'default' | 'spotlight' | 'compact';
}

const {
  title,
  description,
  date,
  slug,
  type,
  platform,
  url,
  thumbnail,
  media,
  poster,
  fallbackVideo,
  images = [],
  source,
  tags = [],
  featured = false,
  aspectRatio = '16:9',
  variant = 'default',
} = Astro.props;

const previewImage = thumbnail || poster || (images.length > 0 ? images[0] : '/images/Nahida_Icon.webp');
const isPortrait = variant === 'compact' ? isPortraitImage(previewImage, aspectRatio) : false;

// Type labels and badges
const typeBadgeConfig: Record<string, { label: string; icon: string; colorClass: string }> = {
  social: {
    label: platform ? platform.toUpperCase() : 'SOCIAL',
    icon: '⚡',
    colorClass: 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border-emerald-500/20',
  },
  video: {
    label: 'LOCAL VIDEO',
    icon: '▶',
    colorClass: 'bg-amber-500/10 text-amber-700 dark:text-amber-400 border-amber-500/20',
  },
  gallery: {
    label: `GALLERY (${images.length})`,
    icon: '❖',
    colorClass: 'bg-teal-500/10 text-teal-700 dark:text-teal-400 border-teal-500/20',
  },
  image: {
    label: 'LOCAL WORK',
    icon: '✦',
    colorClass: 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border-emerald-500/20',
  },
  website: {
    label: 'WEB PROJECT',
    icon: '↗',
    colorClass: 'bg-sky-500/10 text-sky-700 dark:text-sky-400 border-sky-500/20',
  },
  project: {
    label: 'CREATIVE WORKSPACE',
    icon: '★',
    colorClass: 'bg-purple-500/10 text-purple-700 dark:text-purple-400 border-purple-500/20',
  },
};

const badge = typeBadgeConfig[type] || typeBadgeConfig.project;
---

<div
  class:list={[
    'workspace-card group interactive-card glass-panel overflow-hidden flex justify-between border border-sumeru-200/50 dark:border-white/[0.08] transition-all duration-300',
    variant === 'compact' ? 'rounded-none lg:rounded-[11px]' : 'rounded-[11px]',
    variant === 'compact'
      ? (isPortrait
          ? 'flex-row h-[310px] sm:h-[400px] lg:h-[var(--hero-sync-h,570px)]'
          : 'relative flex-col h-[310px] sm:h-[400px] lg:h-[var(--hero-sync-h,570px)]')
      : 'flex-col h-full',
    variant === 'default' && (featured ? 'md:col-span-2' : 'col-span-1')
  ]}
  data-title={title.toLowerCase()}
  data-type={type === 'image' ? 'local work' : type}
  data-platform={platform || (type === 'image' ? 'local work' : 'none')}
  data-tags={tags.map(t => t.toLowerCase()).join('|')}
  data-media-type={type}
  data-media-url={url || media || ''}
  data-media-poster={previewImage}
  data-project-title={title}
  data-project-desc={description}
  data-project-platform={platform || (type === 'image' ? 'Local Work' : (source ? source.platform : type))}
  data-external-url={url || (source ? source.url : '')}
  data-cta-label={source?.label || ''}
  data-fallback-video={fallbackVideo || ''}
  data-aspect-ratio={aspectRatio}
  data-gallery-images={JSON.stringify(images)}
  data-slug={slug}
>
  <!-- Card Media Viewport -->
  <div class:list={[
    'overflow-hidden bg-sumeru-950/20 cursor-pointer project-card-trigger shrink-0',
    variant === 'spotlight'
      ? 'relative w-full h-44 sm:h-52 lg:h-auto lg:flex-1 lg:min-h-[340px]'
      : variant === 'compact'
        ? (isPortrait ? 'relative w-[40%] h-full' : 'absolute inset-0 w-full h-full')
        : ['relative w-full', aspectRatio === '9:16' ? 'aspect-[4/3] sm:aspect-[9/16] max-h-[260px] sm:max-h-[420px]' : (featured ? 'aspect-video sm:aspect-[16/9] md:aspect-[21/9]' : 'aspect-video')]
  ]}>
    <img
      src={previewImage}
      alt={title}
      loading="lazy"
      class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500 ease-out"
      onerror="this.src='/images/Nahida_Icon.webp'"
    />
    <div
      class:list={[
        'absolute inset-0 transition-opacity',
        variant === 'compact' && !isPortrait
          ? 'bg-gradient-to-t from-black/90 via-black/45 to-black/15'
          : 'bg-gradient-to-t from-black/75 via-black/20 to-transparent opacity-75 group-hover:opacity-60'
      ]}
    ></div>

    <!-- Type Badge -->
    <div class="absolute top-3 left-3 sm:top-4 sm:left-4 z-10">
      <span class:list={['inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-0.5 sm:py-1 rounded-full text-[10px] sm:text-xs font-semibold uppercase tracking-wider backdrop-blur-md border shadow-sm', badge.colorClass]}>
        <span>{badge.icon}</span>
        <span>{badge.label}</span>
      </span>
    </div>

    <!-- Quick Preview / Play Action Icon -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white/80 dark:bg-black/70 text-sumeru-950 dark:text-nahida-mint flex items-center justify-center opacity-0 group-hover:opacity-100 transform scale-75 group-hover:scale-100 transition-all duration-300 backdrop-blur-md shadow-lg">
        {type === 'video' || (type === 'social' && platform === 'youtube') ? (
          <svg class="w-5 h-5 ml-0.5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
        ) : type === 'gallery' ? (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        ) : (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
        )}
      </div>
    </div>

    <!-- Date Overlay on Card Media -->
    {(variant !== 'compact' || isPortrait) && (
      <span class="absolute bottom-2.5 right-3 sm:bottom-3 sm:right-3.5 text-[10px] sm:text-xs font-mono text-white/90 drop-shadow-sm">
        {formatDate(date)}
      </span>
    )}
  </div>

  <!-- Card Info Content -->
  <div class:list={[
    'flex flex-col justify-between min-w-0',
    variant === 'default'
      ? 'flex-grow p-4 sm:p-6'
      : isPortrait
        ? 'flex-grow w-[60%] p-3.5 sm:p-5 lg:p-8'
        : 'relative z-10 mt-auto w-full p-3.5 sm:p-6 lg:p-8 text-white pointer-events-none'
  ]}>
    <div>
      {variant === 'compact' && !isPortrait && (
        <span class="block text-[10px] lg:text-xs font-mono text-nahida-mint/95 mb-1 lg:mb-2 drop-shadow-sm">
          {formatDate(date)}
        </span>
      )}
      <h3
        class:list={[
          'font-display font-semibold transition-colors line-clamp-2 leading-snug',
          variant === 'default'
            ? 'text-base sm:text-lg mb-1.5 sm:mb-2 text-sumeru-950 dark:text-nahida-light group-hover:text-sumeru-600 dark:group-hover:text-nahida-mint'
            : isPortrait
              ? 'text-sm sm:text-lg lg:text-2xl mb-1.5 lg:mb-3 text-sumeru-950 dark:text-nahida-light group-hover:text-sumeru-600 dark:group-hover:text-nahida-mint'
              : 'text-base sm:text-xl lg:text-2xl xl:text-[1.75rem] mb-1 lg:mb-2 text-white group-hover:text-nahida-mint drop-shadow-sm'
        ]}
      >
        {title}
      </h3>
      <p
        class:list={[
          'leading-relaxed',
          variant === 'default'
            ? 'text-xs sm:text-sm line-clamp-2 mb-3 sm:mb-4 text-sumeru-800/80 dark:text-nahida-light/70'
            : isPortrait
              ? 'text-[11px] sm:text-xs lg:text-base line-clamp-3 lg:line-clamp-4 mb-2 text-sumeru-800/80 dark:text-nahida-light/75'
              : 'text-[11px] sm:text-xs lg:text-sm line-clamp-2 max-w-2xl mb-2.5 lg:mb-3.5 text-white/85 drop-shadow-sm'
        ]}
        set:html={description}
      />
    </div>

    <div
      class:list={[
        'flex items-center justify-between gap-2 pointer-events-auto',
        variant === 'default'
          ? 'pt-3 sm:pt-4 border-t border-sumeru-200/40 dark:border-white/[0.05]'
          : isPortrait
            ? 'pt-2.5 lg:pt-4 border-t border-sumeru-200/40 dark:border-white/[0.05]'
            : 'pt-1'
      ]}
    >
      <!-- Tags -->
      <div class="flex flex-wrap gap-1.5 items-center">
        {tags.slice(0, 2).map(tag => (
          <span
            class:list={[
              'px-2 py-0.5 rounded-lg text-[10px] lg:text-xs font-medium',
              variant === 'compact' && !isPortrait
                ? 'bg-white/15 text-white border border-white/25 backdrop-blur-sm'
                : 'bg-sumeru-100/70 dark:bg-sumeru-900/40 text-sumeru-800 dark:text-nahida-mint/90'
            ]}
          >
            #{tag}
          </span>
        ))}
      </div>

      <!-- Action Link / Detail Link -->
      <div class="flex items-center gap-2 ml-auto">
        <a
          href={`/workspace/${slug}/`}
          class:list={[
            'text-xs font-semibold hover:underline inline-flex items-center gap-1',
            variant === 'compact' && !isPortrait
              ? 'text-nahida-mint'
              : 'text-sumeru-700 dark:text-nahida-mint'
          ]}
        >
          <span>Explore</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </div>
</div>
