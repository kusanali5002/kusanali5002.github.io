---
---
<div
  id="project-lightbox-modal"
  class="fixed inset-0 z-[100] pointer-events-none opacity-0 transition-opacity duration-300 flex items-center justify-center p-3 sm:p-6 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-project-title"
>
  <!-- Darkened Backdrop with Blur -->
  <div id="modal-backdrop" class="fixed inset-0 bg-black/80 backdrop-blur-md transition-opacity"></div>

  <!-- Modal Dialog Container -->
  <div
    id="modal-panel"
    class="relative z-10 w-full max-w-4xl lg:max-w-5xl xl:max-w-6xl max-h-[92vh] lg:h-[86vh] lg:max-h-[820px] glass-panel rounded-2xl sm:rounded-3xl border border-sumeru-300/30 dark:border-nahida-mint/20 shadow-2xl flex flex-col transform scale-95 transition-all duration-300 bg-white/95 dark:bg-[#0c1611]/95 my-auto overflow-hidden"
  >
    <!-- Modal Header (Inspired by modern motion portfolios) -->
    <div class="px-4 sm:px-6 py-3 sm:py-3.5 border-b border-sumeru-200/50 dark:border-white/[0.08] flex items-center justify-between flex-shrink-0 bg-white/60 dark:bg-[#0c1611]/60 backdrop-blur-sm">
      <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
        <!-- Mac/Dev style window dots -->
        <div class="flex items-center gap-1.5 flex-shrink-0" aria-hidden="true">
          <span class="w-2.5 h-2.5 rounded-full bg-sumeru-400 dark:bg-nahida-mint/50"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-amber-400 dark:bg-nahida-gold/60"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 dark:bg-emerald-400"></span>
        </div>
        <div class="flex items-center gap-2 min-w-0">
          <span id="modal-project-badge" class="px-2.5 sm:px-3 py-0.5 rounded-full text-[10px] sm:text-xs font-semibold uppercase tracking-wider bg-sumeru-100 dark:bg-sumeru-900/60 text-sumeru-900 dark:text-nahida-mint border border-sumeru-200/50 dark:border-nahida-mint/30 flex-shrink-0">
            Media Showcase
          </span>
          <span id="modal-project-platform" class="text-[11px] sm:text-xs font-mono text-sumeru-600 dark:text-nahida-mint/70 truncate"></span>
        </div>
      </div>

      <button
        id="modal-close-btn"
        type="button"
        class="p-2 sm:p-2.5 rounded-xl text-sumeru-800 dark:text-nahida-light hover:bg-black/10 dark:hover:bg-white/10 transition-colors focus-visible:ring-2 focus-visible:ring-sumeru-500 flex-shrink-0"
        aria-label="Close modal dialog"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Two-Part Body: Media on Left, Information on Right on Desktop UI -->
    <div class="flex flex-col lg:flex-row flex-1 min-h-0 overflow-y-auto lg:overflow-hidden">
      <!-- Left Column: Product Video or Image Display -->
      <div
        id="modal-media-stage"
        class="relative w-full lg:w-[58%] xl:w-[62%] h-[48vh] sm:h-[55vh] lg:h-full bg-black flex items-center justify-center overflow-hidden flex-shrink-0 p-2 sm:p-4"
      >
        <!-- Injected dynamically via JS: Video, Iframe, or Image with .player-shell -->
      </div>

      <!-- Right Column: Information Display -->
      <div
        id="modal-info-panel"
        class="w-full lg:w-[42%] xl:w-[38%] flex-1 lg:h-full overflow-y-auto flex flex-col justify-between p-5 sm:p-6 lg:p-7 border-t lg:border-t-0 lg:border-l border-sumeru-200/50 dark:border-white/[0.08] bg-white/90 dark:bg-[#0c1611]/90"
      >
        <div class="space-y-4">
          <!-- Meta Details -->
          <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono text-sumeru-600 dark:text-nahida-mint/75">
            <span id="modal-project-date"></span>
            <span id="modal-project-type-label" class="uppercase tracking-wider"></span>
          </div>

          <h3
            id="modal-project-title"
            class="font-display font-bold text-xl sm:text-2xl text-sumeru-950 dark:text-white leading-snug"
          ></h3>

          <!-- Tags -->
          <div id="modal-project-tags" class="flex flex-wrap gap-1.5 pt-0.5"></div>

          <!-- Description -->
          <div class="pt-3 border-t border-sumeru-200/40 dark:border-white/[0.06]">
            <h4 class="text-[11px] uppercase tracking-wider font-semibold text-sumeru-500 dark:text-nahida-mint/60 mb-2 font-mono">Description</h4>
            <p
              id="modal-project-description"
              class="text-xs sm:text-sm text-sumeru-800/85 dark:text-nahida-light/80 leading-relaxed"
            ></p>
          </div>
        </div>

        <!-- Pinned Bottom Info and Actions -->
        <div class="pt-4 mt-6 border-t border-sumeru-200/40 dark:border-white/[0.06] space-y-3.5 flex-shrink-0">
          <div class="flex items-center gap-2 text-[11px] sm:text-xs text-sumeru-600 dark:text-nahida-mint/70 font-mono">
            <span>Created by Dun</span>
            <span>•</span>
            <span>The Kusanali Creative Workspace</span>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-3">
            <a
              id="modal-detail-link"
              href="#"
              class="text-xs font-semibold text-sumeru-700 dark:text-nahida-mint hover:underline inline-flex items-center gap-1"
            >
              <span>Explore Post</span>
              <span>→</span>
            </a>

            <a
              id="modal-external-cta"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-xl text-xs font-semibold bg-sumeru-600 dark:bg-nahida-mint text-white dark:text-sumeru-950 hover:bg-sumeru-700 dark:hover:bg-white transition-colors shadow-md inline-flex items-center gap-1.5"
            >
              <span id="modal-cta-label">Watch directly on TikTok</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function getModalElements() {
    return {
      modal: document.getElementById('project-lightbox-modal'),
      backdrop: document.getElementById('modal-backdrop'),
      panel: document.getElementById('modal-panel'),
      closeBtn: document.getElementById('modal-close-btn'),
      stage: document.getElementById('modal-media-stage'),
      titleEl: document.getElementById('modal-project-title'),
      descEl: document.getElementById('modal-project-description'),
      platformEl: document.getElementById('modal-project-platform'),
      badgeEl: document.getElementById('modal-project-badge'),
      externalCta: document.getElementById('modal-external-cta') as HTMLAnchorElement | null,
      ctaLabel: document.getElementById('modal-cta-label'),
      dateEl: document.getElementById('modal-project-date'),
      typeLabelEl: document.getElementById('modal-project-type-label'),
      tagsContainer: document.getElementById('modal-project-tags'),
      detailLink: document.getElementById('modal-detail-link') as HTMLAnchorElement | null,
    };
  }

  function getTikTokVideoId(rawUrl: string): string | null {
    try {
      const match = rawUrl.match(/\/video\/(\d+)/);
      return match ? match[1] : null;
    } catch {
      return null;
    }
  }

  function renderFallbackImage(stage: HTMLElement, src: string, alt: string, isVertical = false) {
    const wrapper = document.createElement('div');
    wrapper.className = 'w-full h-full flex items-center justify-center p-2 sm:p-4';
    const img = document.createElement('img');
    img.src = src || '/images/Nahida_Icon.webp';
    img.alt = alt;
    img.className = 'max-h-full max-w-full w-auto h-auto object-contain rounded-xl shadow-2xl';
    wrapper.appendChild(img);
    stage.appendChild(wrapper);
  }

  function getYouTubeIdFromUrl(rawUrl: string): string | null {
    try {
      const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/;
      const match = rawUrl.match(regExp);
      return match && match[2].length === 11 ? match[2] : null;
    } catch {
      return null;
    }
  }

  function renderMediaSliderModal(stage: HTMLElement, slides: Array<any>, title: string, isVertical = false) {
    const container = document.createElement('div');
    container.className = 'media-slider-modal relative w-full h-full overflow-hidden bg-black select-none flex flex-col items-center justify-center';

    const track = document.createElement('div');
    track.className = 'slider-track w-full h-full flex transition-transform duration-500 ease-out will-change-transform';

    slides.forEach((slide, idx) => {
      const slideEl = document.createElement('div');
      slideEl.className = 'slider-slide w-full h-full flex-shrink-0 relative flex items-center justify-center bg-black overflow-hidden p-2 sm:p-4';
      slideEl.setAttribute('data-slide-index', String(idx));

      if (slide.type === 'youtube') {
        const ytId = getYouTubeIdFromUrl(slide.url);
        if (ytId) {
          const wrapper = document.createElement('div');
          wrapper.className = 'w-full h-full relative aspect-video flex items-center justify-center max-w-full max-h-full';
          const iframe = document.createElement('iframe');
          iframe.src = `https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1&enablejsapi=1&rel=0&playsinline=1`;
          iframe.className = 'w-full h-full border-0 absolute inset-0 rounded-xl';
          iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
          iframe.setAttribute('allowfullscreen', 'true');
          iframe.setAttribute('title', slide.title || title);
          wrapper.appendChild(iframe);
          slideEl.appendChild(wrapper);
        }
      } else if (slide.type === 'video') {
        const video = document.createElement('video');
        video.src = slide.url;
        if (slide.poster) video.poster = slide.poster;
        video.controls = true;
        video.playsInline = true;
        video.className = 'max-h-full max-w-full w-auto h-auto object-contain rounded-xl shadow-2xl';
        slideEl.appendChild(video);
      } else {
        const img = document.createElement('img');
        img.src = slide.url;
        img.alt = slide.title || `${title} - slide ${idx + 1}`;
        img.className = 'max-h-full max-w-full w-auto h-auto object-contain rounded-xl shadow-2xl';
        img.loading = idx === 0 ? 'eager' : 'lazy';
        slideEl.appendChild(img);
      }

      // Top label badge
      const label = document.createElement('div');
      label.className = 'absolute top-3 left-3 z-10 px-3 py-1 rounded-full text-[11px] font-mono bg-black/65 backdrop-blur-md text-white/90 border border-white/10 pointer-events-none flex items-center gap-1.5 shadow-md';
      label.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-nahida-mint animate-pulse"></span><span>${idx + 1}/${slides.length} • ${slide.title || `Slide ${idx + 1}`}</span>`;
      slideEl.appendChild(label);

      track.appendChild(slideEl);
    });

    container.appendChild(track);

    // Prev Button
    const prevBtn = document.createElement('button');
    prevBtn.type = 'button';
    prevBtn.className = 'absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-black/65 hover:bg-black/90 text-white flex items-center justify-center border border-white/20 backdrop-blur-md transition-all shadow-xl hover:scale-110 active:scale-95 cursor-pointer';
    prevBtn.setAttribute('aria-label', 'Previous slide');
    prevBtn.innerHTML = '<svg class="w-5 h-5 -ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>';
    container.appendChild(prevBtn);

    // Next Button
    const nextBtn = document.createElement('button');
    nextBtn.type = 'button';
    nextBtn.className = 'absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-black/65 hover:bg-black/90 text-white flex items-center justify-center border border-white/20 backdrop-blur-md transition-all shadow-xl hover:scale-110 active:scale-95 cursor-pointer';
    nextBtn.setAttribute('aria-label', 'Next slide');
    nextBtn.innerHTML = '<svg class="w-5 h-5 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>';
    container.appendChild(nextBtn);

    // Bottom Horizontal Slide Control Tabs
    const tabsContainer = document.createElement('div');
    tabsContainer.className = 'absolute bottom-3 left-1/2 -translate-x-1/2 z-20 flex items-center gap-1.5 p-1 rounded-full bg-black/80 backdrop-blur-md border border-white/15 max-w-[94%] overflow-x-auto shadow-2xl';

    const tabElements: HTMLButtonElement[] = [];

    slides.forEach((slide, idx) => {
      const tabBtn = document.createElement('button');
      tabBtn.type = 'button';
      tabBtn.className = 'px-3 py-1 rounded-full text-[10px] sm:text-xs font-mono tracking-wider transition-all duration-300 flex items-center gap-1.5 cursor-pointer whitespace-nowrap text-white/70 hover:text-white hover:bg-white/10';
      tabBtn.setAttribute('aria-label', `Go to slide ${idx + 1}: ${slide.title || 'Slide'}`);
      tabBtn.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-current opacity-70"></span><span class="truncate max-w-[100px] sm:max-w-[140px]">${slide.title || `Slide ${idx + 1}`}</span>`;
      tabElements.push(tabBtn);
      tabsContainer.appendChild(tabBtn);
    });

    container.appendChild(tabsContainer);
    stage.appendChild(container);

    let currentIndex = 0;
    const totalSlides = slides.length;

    function updateModalSlider(index: number) {
      currentIndex = (index + totalSlides) % totalSlides;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      tabElements.forEach((tab, idx) => {
        if (idx === currentIndex) {
          tab.className = 'px-3 py-1 rounded-full text-[10px] sm:text-xs font-mono tracking-wider transition-all duration-300 flex items-center gap-1.5 cursor-pointer whitespace-nowrap bg-sumeru-600 dark:bg-nahida-mint text-white dark:text-sumeru-950 font-semibold shadow-md';
        } else {
          tab.className = 'px-3 py-1 rounded-full text-[10px] sm:text-xs font-mono tracking-wider transition-all duration-300 flex items-center gap-1.5 cursor-pointer whitespace-nowrap text-white/70 hover:text-white hover:bg-white/10';
        }
      });
    }

    prevBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      updateModalSlider(currentIndex - 1);
    });

    nextBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      updateModalSlider(currentIndex + 1);
    });

    tabElements.forEach((tab, idx) => {
      tab.addEventListener('click', (e) => {
        e.stopPropagation();
        updateModalSlider(idx);
      });
    });

    updateModalSlider(0);
  }

  function openModal(card: HTMLElement) {
    const {
      modal,
      panel,
      stage,
      titleEl,
      descEl,
      platformEl,
      badgeEl,
      externalCta,
      ctaLabel,
      dateEl,
      typeLabelEl,
      tagsContainer,
      detailLink,
    } = getModalElements();

    if (!modal || !stage || !panel) return;

    const type = card.getAttribute('data-media-type') || 'project';
    const url = card.getAttribute('data-media-url') || '';
    const poster = card.getAttribute('data-media-poster') || '';
    const title = card.getAttribute('data-project-title') || '';
    const desc = card.getAttribute('data-project-desc') || '';
    const platform = card.getAttribute('data-project-platform') || '';
    const externalUrl = card.getAttribute('data-external-url') || '';
    const fallbackVideo = card.getAttribute('data-fallback-video') || '';
    const aspectRatio = card.getAttribute('data-aspect-ratio') || '16:9';
    const galleryImages = JSON.parse(card.getAttribute('data-gallery-images') || '[]');
    const isVertical = aspectRatio === '9:16' || platform.toLowerCase() === 'tiktok';
    const slug = card.getAttribute('data-slug') || '';
    const projectDate = card.getAttribute('data-project-date') || '';
    let projectTags: string[] = [];
    try {
      projectTags = JSON.parse(card.getAttribute('data-project-tags') || '[]');
    } catch {
      projectTags = [];
    }

    if (titleEl) titleEl.textContent = title;
    if (descEl) descEl.innerHTML = desc;
    const isLocalWork = type === 'image' || platform.toLowerCase() === 'local work';
    if (platformEl) platformEl.textContent = isLocalWork ? '@Local Work' : (platform ? `@${platform}` : '');
    if (badgeEl) badgeEl.textContent = (isLocalWork ? 'LOCAL WORK' : (platform || type)).toUpperCase();

    if (dateEl) dateEl.textContent = projectDate;
    if (typeLabelEl) typeLabelEl.textContent = isLocalWork ? 'Local Work' : (platform ? platform.toUpperCase() : type.toUpperCase());

    if (tagsContainer) {
      tagsContainer.innerHTML = '';
      projectTags.forEach((tag) => {
        const tagSpan = document.createElement('span');
        tagSpan.className = 'px-2 py-0.5 rounded-lg text-[10px] sm:text-xs font-medium bg-sumeru-100/80 dark:bg-sumeru-900/50 text-sumeru-800 dark:text-nahida-mint/90 border border-sumeru-200/60 dark:border-nahida-mint/20';
        tagSpan.textContent = `#${tag}`;
        tagsContainer.appendChild(tagSpan);
      });
    }

    if (detailLink) {
      if (slug) {
        detailLink.href = `/workspace/${slug}/`;
        detailLink.classList.remove('hidden');
      } else {
        detailLink.classList.add('hidden');
      }
    }

    if (externalCta && ctaLabel) {
      if (externalUrl || url) {
        externalCta.href = externalUrl || url;
        externalCta.classList.remove('hidden');
        const customCta = card.getAttribute('data-cta-label');
        const plat = (platform || '').toLowerCase();
        if (customCta) {
          ctaLabel.textContent = customCta;
        } else if (plat === 'tiktok') {
          ctaLabel.textContent = 'Watch directly on TikTok';
        } else if (plat === 'youtube') {
          ctaLabel.textContent = 'Watch directly on YouTube';
        } else {
          ctaLabel.textContent = `Watch on ${platform || 'Source'}`;
        }
      } else {
        externalCta.classList.add('hidden');
      }
    }

    // Render Stage Content Based on Type
    stage.innerHTML = '';

    let projectSlides: Array<any> = [];
    try {
      projectSlides = JSON.parse(card.getAttribute('data-slides') || '[]');
    } catch {
      projectSlides = [];
    }

    const tiktokId = getTikTokVideoId(url) || getTikTokVideoId(externalUrl);

    if (projectSlides && projectSlides.length > 0) {
      renderMediaSliderModal(stage, projectSlides, title, isVertical);
    } else if (type === 'video' || fallbackVideo) {
      const shell = document.createElement('div');
      shell.className = isVertical ? 'player-shell vertical shadow-2xl' : 'player-shell shadow-2xl';
      const video = document.createElement('video');
      video.src = fallbackVideo || url;
      video.poster = poster;
      video.controls = true;
      video.autoplay = true;
      video.playsInline = true;
      video.className = 'w-full h-full object-contain';
      shell.appendChild(video);
      stage.appendChild(shell);
    } else if (tiktokId || platform.toLowerCase() === 'tiktok') {
      if (tiktokId) {
        const shell = document.createElement('div');
        shell.className = 'player-shell vertical shadow-2xl';
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.tiktok.com/player/v1/${tiktokId}?autoplay=1&loop=0&rel=0&music_info=0&description=0&muted=0&volume_control=1`;
        iframe.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture; fullscreen');
        iframe.setAttribute('allowfullscreen', 'true');
        iframe.setAttribute('title', title);
        iframe.onload = () => {
          try {
            const win = iframe.contentWindow;
            win?.postMessage({ type: 'unMute', value: undefined, 'x-tiktok-player': true }, 'https://www.tiktok.com');
            win?.postMessage({ type: 'play', value: undefined, 'x-tiktok-player': true }, 'https://www.tiktok.com');
          } catch {}
        };
        shell.appendChild(iframe);
        stage.appendChild(shell);
      } else {
        renderFallbackImage(stage, poster, title, isVertical);
      }
    } else if (type === 'social' && platform.toLowerCase() === 'youtube') {
      const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/;
      const match = url.match(regExp);
      const videoId = (match && match[2].length === 11) ? match[2] : null;

      if (videoId) {
        const shell = document.createElement('div');
        shell.className = isVertical ? 'player-shell vertical shadow-2xl' : 'player-shell shadow-2xl';
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&playsinline=1&controls=1&loop=1&playlist=${videoId}`;
        iframe.setAttribute('frameborder', '0');
        iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
        iframe.setAttribute('allowfullscreen', 'true');
        iframe.setAttribute('title', title);
        shell.appendChild(iframe);
        stage.appendChild(shell);
      } else {
        renderFallbackImage(stage, poster, title, isVertical);
      }
    } else if (type === 'gallery' && galleryImages.length > 0) {
      const shell = document.createElement('div');
      shell.className = 'w-full h-full flex items-center justify-center p-2 sm:p-4';
      const img = document.createElement('img');
      img.src = galleryImages[0];
      img.alt = title;
      img.className = 'max-h-full max-w-full w-auto h-auto object-contain rounded-xl shadow-2xl';
      shell.appendChild(img);
      stage.appendChild(shell);
    } else {
      renderFallbackImage(stage, poster, title, isVertical);
    }

    modal.classList.remove('pointer-events-none', 'opacity-0');
    modal.classList.add('pointer-events-auto', 'opacity-100');
    panel.classList.remove('scale-95');
    panel.classList.add('scale-100');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    const { modal, panel, stage } = getModalElements();
    if (!modal || !panel) return;

    modal.classList.add('pointer-events-none', 'opacity-0');
    modal.classList.remove('pointer-events-auto', 'opacity-100');
    panel.classList.add('scale-95');
    panel.classList.remove('scale-100');
    document.body.style.overflow = '';
    setTimeout(() => {
      if (stage) stage.innerHTML = '';
    }, 300);
  }

  function initGlobalProjectModalHandlers() {
    if ((window as any).__projectModalInitialized) return;
    (window as any).__projectModalInitialized = true;

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      const trigger = target.closest('.project-card-trigger');
      if (trigger) {
        e.preventDefault();
        const card = trigger.closest('.workspace-card') as HTMLElement;
        if (card) openModal(card);
        return;
      }

      if (target.closest('#modal-close-btn') || target.closest('#modal-backdrop')) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const { modal } = getModalElements();
        if (modal?.classList.contains('opacity-100')) {
          closeModal();
        }
      }

      if (e.key === 'Enter' || e.key === ' ') {
        const target = e.target as HTMLElement | null;
        const trigger = target?.closest('.project-card-trigger');
        if (trigger) {
          e.preventDefault();
          const card = trigger.closest('.workspace-card') as HTMLElement;
          if (card) openModal(card);
        }
      }
    });
  }

  initGlobalProjectModalHandlers();
  document.addEventListener('astro:page-load', initGlobalProjectModalHandlers);
  document.addEventListener('astro:after-swap', () => {
    const { modal } = getModalElements();
    if (!modal || modal.classList.contains('opacity-0')) {
      document.body.style.overflow = '';
    }
  });
</script>
