---
---

<div class="w-full h-full glass-panel rounded-[11px] p-4 sm:p-5 lg:p-6 border border-sumeru-300/50 dark:border-nahida-mint/20 relative overflow-hidden group shadow-xl flex flex-col justify-between">
  <!-- Atmospheric ambient glow -->
  <div class="absolute -right-20 -top-20 w-80 h-80 rounded-full bg-nahida-mint/20 dark:bg-nahida-mint/10 blur-3xl pointer-events-none group-hover:scale-110 transition-transform duration-700"></div>

  <div class="grid grid-cols-12 gap-3.5 sm:gap-6 lg:gap-8 items-center sm:items-stretch relative z-10 w-full h-full min-h-0 flex-grow">
    <!-- Portrait Frame (Natural 4:5 on Mobile, Full-Height Poster on Desktop) -->
    <div class="col-span-5 md:col-span-6 flex items-center sm:items-stretch min-h-0">
      <div class="relative w-full aspect-[4/5] sm:aspect-auto sm:h-full rounded-[11px] overflow-hidden border border-sumeru-300/60 dark:border-nahida-mint/40 shadow-lg group-hover:shadow-xl transition-shadow">
        <img
          src="/images/nahida_graphic_design.jpg"
          alt="Lesser Lord Kusanali"
          class="w-full h-full object-cover object-center transform group-hover:scale-105 transition-transform duration-700"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/15 via-transparent to-transparent pointer-events-none"></div>
      </div>
    </div>

    <!-- Text & Identity -->
    <div class="col-span-7 md:col-span-6 flex flex-col justify-center space-y-2 sm:space-y-3.5 sm:py-2 sm:pr-2 text-left min-w-0">
      <div>
        <span class="inline-block px-2.5 sm:px-3.5 py-0.5 sm:py-1 rounded-full text-[9px] sm:text-xs font-mono font-semibold uppercase tracking-wider bg-sumeru-100 dark:bg-sumeru-900/60 text-sumeru-800 dark:text-nahida-mint border border-sumeru-200/50 dark:border-nahida-mint/20 mb-1.5 sm:mb-3" data-i18n="hero-badge">
          THE MUSE OF SUMERU
        </span>

        <h1 class="font-display font-bold text-lg sm:text-3xl lg:text-4xl xl:text-[2.6rem] text-sumeru-950 dark:text-white tracking-tight leading-tight" data-i18n="hero-title">
          Lesser Lord Kusanali
        </h1>
      </div>

      <p class="text-[11px] sm:text-sm lg:text-base text-sumeru-800/85 dark:text-nahida-light/85 leading-relaxed max-w-xl" data-i18n="hero-quote">
        "Hello, I'm the Lesser Lord Kusanali or commonly known as Nahida, is Sumeru's current Dendro Archon. This is Dun's blog but when he is absent, I will be manager. Let's take a look around and you can find something interesting about him :3"
      </p>

      <!-- Desktop Buttons -->
      <div class="hidden sm:flex pt-2 flex-wrap items-center justify-start gap-3">
        <a
          href="/nahida/"
          class="px-5 py-2.5 rounded-xl bg-sumeru-600 dark:bg-nahida-mint text-white dark:text-sumeru-950 text-xs font-semibold hover:bg-sumeru-700 dark:hover:bg-white transition-all shadow-md inline-flex items-center gap-2"
        >
          <span data-i18n="hero-btn-nahida">Visit Nahida Shrine</span>
          <span>✦</span>
        </a>
        <a
          href="/about/"
          class="px-5 py-2.5 rounded-xl glass-panel border border-sumeru-300/60 dark:border-nahida-mint/30 text-sumeru-900 dark:text-nahida-light text-xs font-semibold hover:border-sumeru-500 dark:hover:border-nahida-mint transition-all inline-flex items-center gap-2"
        >
          <span data-i18n="hero-btn-about">About The Author</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile Full-Width Action Bar (keeps top 2-col image proportional) -->
  <div class="sm:hidden relative z-10 mt-3.5 pt-3 border-t border-sumeru-200/50 dark:border-white/[0.08] grid grid-cols-2 gap-2">
    <a
      href="/nahida/"
      class="px-2 py-2 rounded-xl bg-sumeru-600 dark:bg-nahida-mint text-white dark:text-sumeru-950 text-[10px] font-semibold hover:bg-sumeru-700 dark:hover:bg-white transition-all shadow-md inline-flex items-center justify-center gap-1 whitespace-nowrap"
    >
      <span data-i18n="hero-btn-nahida">Visit Nahida Shrine</span>
      <span>✦</span>
    </a>
    <a
      href="/about/"
      class="px-2 py-2 rounded-xl glass-panel border border-sumeru-300/60 dark:border-nahida-mint/30 text-sumeru-900 dark:text-nahida-light text-[10px] font-semibold hover:border-sumeru-500 dark:hover:border-nahida-mint transition-all inline-flex items-center justify-center gap-1 whitespace-nowrap"
    >
      <span data-i18n="hero-btn-about">About The Author</span>
      <span>→</span>
    </a>
  </div>
</div>
