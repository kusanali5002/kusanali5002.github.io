---
---

<section class="relative pt-6 pb-12 sm:pt-10 sm:pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="reveal-on-scroll glass-panel rounded-3xl p-6 sm:p-10 lg:p-12 border border-sumeru-300/50 dark:border-nahida-mint/20 relative overflow-hidden group shadow-xl">
    <!-- Atmospheric ambient glow -->
    <div class="absolute -right-20 -top-20 w-80 h-80 rounded-full bg-nahida-mint/20 dark:bg-nahida-mint/10 blur-3xl pointer-events-none group-hover:scale-110 transition-transform duration-700"></div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 sm:gap-8 lg:gap-10 items-center relative z-10">
      <!-- Portrait Frame -->
      <div class="md:col-span-4 flex justify-center md:justify-start">
        <div class="relative w-44 h-44 sm:w-56 sm:h-56 rounded-3xl overflow-hidden border-2 border-sumeru-300/60 dark:border-nahida-mint/40 shadow-xl shrink-0 group-hover:shadow-2xl transition-shadow">
          <img
            src="/images/nahida.jpg"
            alt="Lesser Lord Kusanali"
            class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
        </div>
      </div>

      <!-- Text & Identity -->
      <div class="md:col-span-8 space-y-4 text-center md:text-left">
        <div>
          <span class="inline-block px-3.5 py-1 rounded-full text-xs font-mono font-semibold uppercase tracking-wider bg-sumeru-100 dark:bg-sumeru-900/60 text-sumeru-800 dark:text-nahida-mint border border-sumeru-200/50 dark:border-nahida-mint/20 mb-5" data-i18n="hero-badge">
            PHYSIC OF PURITY
          </span>

          <h1 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-sumeru-950 dark:text-white tracking-tight leading-tight" data-i18n="hero-title">
            Lesser Lord Kusanali
          </h1>
        </div>

        <p class="text-sm sm:text-base text-sumeru-800/85 dark:text-nahida-light/85 leading-relaxed max-w-2xl" data-i18n="hero-quote">
          "Hello, I'm the Lesser Lord Kusanali or commonly known as Nahida, is Sumeru's current Dendro Archon. This is Dun's blog but when he is absent, I will be manager. Let's take a look around and you can find something interesting about him :3"
        </p>

        <div class="pt-2 flex flex-wrap items-center justify-center md:justify-start gap-4">
          <a
            href="/nahida/"
            class="px-5 py-2.5 rounded-xl bg-sumeru-600 dark:bg-nahida-mint text-white dark:text-sumeru-950 text-xs font-semibold hover:bg-sumeru-700 dark:hover:bg-white transition-all shadow-md inline-flex items-center gap-2"
          >
            <span data-i18n="hero-btn-nahida">Visit Nahida Shrine</span>
            <span>✦</span>
          </a>
          <a
            href="/about/"
            class="px-5 py-2.5 rounded-xl glass-panel border border-sumeru-300/60 dark:border-nahida-mint/30 text-sumeru-900 dark:text-nahida-light text-xs font-semibold hover:border-sumeru-500 dark:hover:border-nahida-mint transition-all inline-flex items-center gap-2"
          >
            <span data-i18n="hero-btn-about">About Dun</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
