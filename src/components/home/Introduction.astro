---
---

<div class="w-full h-full grid grid-cols-2 lg:grid-cols-1 gap-4 sm:gap-5">
  <!-- Bento Tile 1: Activities -->
  <div class="p-4 sm:p-6 rounded-[11px] glass-panel border border-sumeru-200/60 dark:border-white/[0.08] flex flex-col justify-between group hover:border-sumeru-400 dark:hover:border-nahida-mint/40 transition-all">
    <div>
      <div class="mb-3">
        <span class="inline-block px-2.5 sm:px-3 py-1 rounded-full text-[10px] sm:text-xs font-mono font-semibold uppercase tracking-wider bg-sumeru-100 dark:bg-sumeru-900/60 text-sumeru-800 dark:text-nahida-mint border border-sumeru-200/50 dark:border-nahida-mint/20" data-i18n="intro-act-badge">
          Game analysis & Daily Life
        </span>
      </div>

      <h2 class="font-display font-bold text-lg sm:text-2xl text-sumeru-950 dark:text-white mb-1" data-i18n="intro-act-title">
        Activities
      </h2>
      <p class="text-[10px] sm:text-xs uppercase font-mono tracking-widest text-sumeru-600 dark:text-nahida-mint mb-2">
        READ • LEARN • THINK
      </p>
      <p class="text-xs sm:text-sm text-sumeru-800/80 dark:text-nahida-light/75 leading-relaxed line-clamp-3 sm:line-clamp-none" data-i18n="intro-act-desc">
        The written chronicle. Short analyses on game design, statistical studies on gacha mechanics, esports commentary, and candid reflections from university and daily life.
      </p>
    </div>

    <div class="mt-4 pt-3 border-t border-sumeru-200/40 dark:border-white/[0.05]">
      <a
        href="/activities/"
        class="inline-flex items-center gap-1.5 text-[11px] sm:text-xs font-semibold uppercase tracking-wider text-sumeru-700 dark:text-nahida-mint group-hover:text-sumeru-950 dark:group-hover:text-white transition-colors"
      >
        <span data-i18n="intro-act-link">Browse All Articles</span>
        <span class="transform group-hover:translate-x-1 transition-transform">→</span>
      </a>
    </div>
  </div>

  <!-- Bento Tile 2: Workspace -->
  <div class="p-4 sm:p-6 rounded-[11px] glass-panel border border-sumeru-200/60 dark:border-white/[0.08] flex flex-col justify-between group hover:border-sumeru-400 dark:hover:border-nahida-mint/40 transition-all">
    <div>
      <div class="mb-3">
        <span class="inline-block px-2.5 sm:px-3 py-1 rounded-full text-[10px] sm:text-xs font-mono font-semibold uppercase tracking-wider bg-amber-500/10 dark:bg-nahida-gold/15 text-amber-800 dark:text-nahida-gold border border-amber-500/20 dark:border-nahida-gold/30" data-i18n="intro-ws-badge">
          CREATIVE WORKSPACE
        </span>
      </div>

      <h2 class="font-display font-bold text-lg sm:text-2xl text-sumeru-950 dark:text-white mb-1" data-i18n="intro-ws-title">
        Workspace
      </h2>
      <p class="text-[10px] sm:text-xs uppercase font-mono tracking-widest text-amber-700 dark:text-nahida-gold mb-2">
        MAKE • CREATE • EXPERIMENT
      </p>
      <p class="text-xs sm:text-sm text-sumeru-800/80 dark:text-nahida-light/75 leading-relaxed line-clamp-3 sm:line-clamp-none" data-i18n="intro-ws-desc">
        The creative workshop. Motion graphics reels, TikTok clips and GFX arts.
      </p>
    </div>

    <div class="mt-4 pt-3 border-t border-sumeru-200/40 dark:border-white/[0.05]">
      <a
        href="/workspace/"
        class="inline-flex items-center gap-1.5 text-[11px] sm:text-xs font-semibold uppercase tracking-wider text-amber-700 dark:text-nahida-gold group-hover:text-amber-950 dark:group-hover:text-white transition-colors"
      >
        <span data-i18n="intro-ws-link">Explore The Workspace</span>
        <span class="transform group-hover:translate-x-1 transition-transform">→</span>
      </a>
    </div>
  </div>
</div>
