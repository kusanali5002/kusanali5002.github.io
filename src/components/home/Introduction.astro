---
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 border-t border-sumeru-200/40 dark:border-white/[0.05]">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
    <!-- Pillar 1: Activities -->
    <div class="reveal-on-scroll p-8 sm:p-10 rounded-3xl glass-panel border border-sumeru-200/60 dark:border-white/[0.08] flex flex-col justify-between group hover:border-sumeru-400 dark:hover:border-nahida-mint/40 transition-all">
      <div>
        <div class="flex items-center justify-between mb-6">
          <span class="px-3.5 py-1 rounded-full text-xs font-mono font-semibold uppercase tracking-wider bg-sumeru-100 dark:bg-sumeru-900/60 text-sumeru-800 dark:text-nahida-mint border border-sumeru-200/50 dark:border-nahida-mint/20">
            Game analysis & Daily Life
          </span>
          <span class="text-xs font-mono text-sumeru-400 dark:text-gray-500">01</span>
        </div>

        <h3 class="font-display font-bold text-2xl sm:text-3xl text-sumeru-950 dark:text-white mb-3">
          Activities
        </h3>
        <p class="text-xs uppercase font-mono tracking-widest text-sumeru-600 dark:text-nahida-mint mb-4">
          READ • LEARN • THINK
        </p>
        <p class="text-sm sm:text-base text-sumeru-800/80 dark:text-nahida-light/75 leading-relaxed">
          The written chronicle. Short analyses on game design, statistical studies on gacha mechanics, esports commentary, and candid reflections from university and daily life.
        </p>
      </div>

      <div class="mt-8 pt-6 border-t border-sumeru-200/40 dark:border-white/[0.05]">
        <a
          href="/activities/"
          class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-sumeru-700 dark:text-nahida-mint group-hover:text-sumeru-950 dark:group-hover:text-white transition-colors"
        >
          <span>Browse All Articles</span>
          <span class="transform group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </div>

    <!-- Pillar 2: Workspace -->
    <div class="reveal-on-scroll p-8 sm:p-10 rounded-3xl glass-panel border border-sumeru-200/60 dark:border-white/[0.08] flex flex-col justify-between group hover:border-sumeru-400 dark:hover:border-nahida-mint/40 transition-all">
      <div>
        <div class="flex items-center justify-between mb-6">
          <span class="px-3.5 py-1 rounded-full text-xs font-mono font-semibold uppercase tracking-wider bg-amber-500/10 dark:bg-nahida-gold/15 text-amber-800 dark:text-nahida-gold border border-amber-500/20 dark:border-nahida-gold/30">
            CREATIVE WORKSPACE
          </span>
          <span class="text-xs font-mono text-sumeru-400 dark:text-gray-500">02</span>
        </div>

        <h3 class="font-display font-bold text-2xl sm:text-3xl text-sumeru-950 dark:text-white mb-3">
          Workspace
        </h3>
        <p class="text-xs uppercase font-mono tracking-widest text-amber-700 dark:text-nahida-gold mb-4">
          MAKE • CREATE • EXPERIMENT
        </p>
        <p class="text-sm sm:text-base text-sumeru-800/80 dark:text-nahida-light/75 leading-relaxed">
          The creative workshop. Motion graphics reels, TikTok clips and GFX arts.
        </p>
      </div>

      <div class="mt-8 pt-6 border-t border-sumeru-200/40 dark:border-white/[0.05]">
        <a
          href="/workspace/"
          class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-amber-700 dark:text-nahida-gold group-hover:text-amber-950 dark:group-hover:text-white transition-colors"
        >
          <span>Explore The Workspace</span>
          <span class="transform group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
