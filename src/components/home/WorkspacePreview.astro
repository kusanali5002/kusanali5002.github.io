---
import MediaProjectCard from '../workspace/MediaProjectCard.astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  projects: CollectionEntry<'workspace'>[];
}

const { projects } = Astro.props;
const featuredProjects = projects.slice(0, 3);
---

<section class="pt-8 sm:pt-10 lg:pt-12 border-t border-sumeru-200/40 dark:border-white/[0.05]" data-carousel-section>
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-5 sm:mb-7 gap-3">
    <div>
      <span class="text-[10px] sm:text-xs font-mono font-semibold uppercase tracking-widest text-amber-700 dark:text-nahida-gold mb-1 sm:mb-2 block" data-i18n="ws-label">
        Creative Workspace
      </span>
      <h2 class="font-display font-bold text-xl sm:text-3xl lg:text-3xl text-sumeru-950 dark:text-white leading-tight" data-i18n="ws-title">
        All Social & Local Works
      </h2>
    </div>

    <a
      href="/workspace/"
      class="text-[11px] sm:text-xs font-semibold uppercase tracking-wider text-amber-700 dark:text-nahida-gold hover:underline inline-flex items-center gap-1 group"
    >
      <span data-i18n="ws-viewall" data-count={projects.length}>Open Workspace ({projects.length})</span>
      <span class="transform group-hover:translate-x-1 transition-transform">→</span>
    </a>
  </div>

  <!-- Full-Width Swipe Carousel (Mobile: edge-to-edge | Desktop: aligned flush with Hero + hover arrows) -->
  <div class="relative group/carousel" data-carousel-wrap>
    <button
      type="button"
      data-carousel-prev
      aria-label="Previous work"
      class="hidden lg:flex items-center justify-center absolute left-3 top-1/2 -translate-y-1/2 z-30 w-10 h-10 rounded-full bg-white/85 dark:bg-black/65 backdrop-blur-md border border-amber-500/40 dark:border-nahida-gold/35 text-amber-800 dark:text-nahida-gold shadow-lg opacity-0 group-hover/carousel:opacity-100 focus-visible:opacity-100 hover:scale-105 hover:bg-white dark:hover:bg-black/85 transition-all duration-200"
    >
      ←
    </button>
    <button
      type="button"
      data-carousel-next
      aria-label="Next work"
      class="hidden lg:flex items-center justify-center absolute right-3 top-1/2 -translate-y-1/2 z-30 w-10 h-10 rounded-full bg-white/85 dark:bg-black/65 backdrop-blur-md border border-amber-500/40 dark:border-nahida-gold/35 text-amber-800 dark:text-nahida-gold shadow-lg opacity-0 group-hover/carousel:opacity-100 focus-visible:opacity-100 hover:scale-105 hover:bg-white dark:hover:bg-black/85 transition-all duration-200"
    >
      →
    </button>

    <div class="swipe-carousel flex gap-0 overflow-x-auto overflow-y-hidden snap-x snap-mandatory -mx-4 sm:-mx-6 lg:mx-0 items-stretch" data-auto-advance="10000">
      {featuredProjects.map((proj) => (
        <div class="swipe-slide relative w-full min-w-full shrink-0 snap-center snap-always reveal-on-scroll">
          <MediaProjectCard
            title={proj.data.title}
            description={proj.data.description}
            date={proj.data.date}
            slug={proj.id.replace(/\.md$/, '')}
            type={proj.data.type}
            platform={proj.data.platform}
            url={proj.data.url}
            thumbnail={proj.data.thumbnail}
            media={proj.data.media}
            poster={proj.data.poster}
            fallbackVideo={proj.data.fallbackVideo}
            images={proj.data.images}
            source={proj.data.source}
            tags={proj.data.tags}
            featured={false}
            aspectRatio={proj.data.aspectRatio}
            variant="compact"
          />
        </div>
      ))}
    </div>
  </div>
</section>
